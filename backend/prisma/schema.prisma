model BusinessPartner {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  bpType             String    @map("bp_type") @db.VarChar(20)
  refId              String?   @map("ref_id") @db.Uuid
  // Optional stable key for bulk-upload matching (create-vs-update). Never
  // required for manual create — only set when the org wants reliable
  // re-import. Unique per org when present (see migration_007's partial
  // index; NULLs are unconstrained so most manually-created partners never
  // need one).
  code               String?   @db.VarChar(30)
  name               String    @db.VarChar(200)
  gstin              String?   @db.VarChar(15)
  phone              String?   @db.VarChar(20)
  email              String?   @db.VarChar(255)
  address            Json?
  // GST state code — see Branch.stateCode for how this feeds the
  // CGST+SGST vs IGST determination at Sales/Purchase posting time.
  stateCode          String?   @map("state_code") @db.VarChar(2)
  openingBalance     Decimal   @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingBalanceType String?   @map("opening_balance_type") @db.VarChar(6)
  isActive           Boolean   @default(true) @map("is_active")
  // ── Vendor Management (Phase 1) — see migration_028. Only meaningful for
  // bp_type = 'VENDOR', but not DB-enforced to that (same convention as
  // openingBalance/address being present-but-unused on the other bpType).
  vendorCategory     String?   @map("vendor_category") @db.VarChar(30)
  // Single-step placeholder workflow — DEFAULT 'APPROVED' so every
  // existing partner (and anything not deliberately using this feature)
  // is unaffected. See migration_028's header comment: designed to be
  // swapped for a real Workflow Management System later without a data
  // migration — same shape as PurchaseBill.status.
  approvalStatus     String    @default("APPROVED") @map("approval_status") @db.VarChar(20)
  approvedBy         String?   @map("approved_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at")
  rejectedBy         String?   @map("rejected_by") @db.Uuid
  rejectedAt         DateTime? @map("rejected_at")
  rejectionReason    String?   @map("rejection_reason") @db.VarChar(500)
  // International tax registration — separate from gstin (never read by
  // the India GST engine's isInterState/splitGst). Display-only: a
  // foreign vendor's own tax reference for the org's records. taxIdType
  // is a free-standing label ("EIN", "GST/HST No.", "VAT No.", ...), not
  // a DB-enforced enum — same convention as openingBalanceType.
  taxIdType          String?   @map("tax_id_type") @db.VarChar(20)
  taxId              String?   @map("tax_id") @db.VarChar(50)
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")

  organization  Organization    @relation(fields: [organizationId], references: [id])
  journalLines  JournalLine[]
  itemLink      Item?
  salesInvoices SalesInvoice[]
  purchaseBills PurchaseBill[]
  salesReturns    SalesReturn[]
  purchaseReturns PurchaseReturn[]
