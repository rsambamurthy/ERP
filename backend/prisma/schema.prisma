  businessPartnerId String? @map("business_partner_id") @db.Uuid
  debit             Decimal @default(0) @db.Decimal(14, 2)
  credit            Decimal @default(0) @db.Decimal(14, 2)
  narration         String? @db.VarChar(255)

  journalEntry    JournalEntry     @relation(fields: [journalEntryId], references: [id])
  account         Account          @relation(fields: [accountId], references: [id])
  businessPartner BusinessPartner? @relation(fields: [businessPartnerId], references: [id])

  @@map("journal_lines")
}

// ── Currency Master ─────────────────────────────────────────────────────
// Effective-dated FX rates — the currency code/symbol/name list itself
// stays the small hardcoded array in lib/currencies.ts (display metadata
// only, same convention as SCHEDULE_III_HEADS), but *what rate applies*
// varies by date, so that part is real per-org master data with its own
// bulk upload. A currency code can have any number of rows here, one per
// effective date — same "history of independent point-in-time facts, not
// a single mutable row" shape as an opening balance or a price list, not
// a live-updating single "current rate" field.
//
// `rate` follows the exact meaning `SalesInvoice.exchangeRate` /
// `PurchaseBill.exchangeRate` already use: "1 unit of currencyCode = rate
// INR" (see the "Exchange Rate (1 {currency} = ₹)" label on both forms).
// Nothing here is a foreign key target — a posted invoice/bill still
// snapshots its own `exchangeRate` value directly at posting time (never a
// pointer back to a CurrencyRate row), so editing or deleting a rate here
// never touches anything already posted. This table exists purely to
// *pre-fill* that field faster and more consistently than always typing
// it by hand — see the lookup endpoint in routes/currencyRates.ts.
model CurrencyRate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  currencyCode   String   @map("currency_code") @db.VarChar(3)
  effectiveFrom  DateTime @map("effective_from") @db.Date
  rate           Decimal  @db.Decimal(14, 6)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, currencyCode, effectiveFrom])
  @@map("currency_rates")
}

// ── Recurring Expenses ───────────────────────────────────────────────────
// A template for an expense that repeats monthly. Generating one produces a
// Purchase Bill of SERVICE items (migration_029) rather than a Journal
// Entry, because lib/gstReports.ts sources GSTR-3B's ITC exclusively from
// purchase_bills — a JV-based recurring expense would quietly forfeit input
// credit on rent, telecom and professional fees.

model RecurringExpense {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  branchId          String?   @map("branch_id") @db.Uuid
  name              String    @db.VarChar(200)
  businessPartnerId String    @map("business_partner_id") @db.Uuid
  // 1..28 by CHECK constraint. Higher values would need a rule for what the
  // 31st of February means, and that rule is always the thing nobody
  // remembers — see migration_030's comment.
  dayOfMonth        Int       @default(1) @map("day_of_month") @db.SmallInt
  // Both pinned to the 1st of their month.
  startMonth        DateTime  @map("start_month") @db.Date
  endMonth          DateTime? @map("end_month") @db.Date
  // FIXED — lines carry a rate. PROMPTED — entered fresh each month.
  amountMode        String    @default("FIXED") @map("amount_mode") @db.VarChar(10)
  narration         String?   @db.VarChar(255)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  organization    Organization             @relation(fields: [organizationId], references: [id])
  branch          Branch?                  @relation(fields: [branchId], references: [id])
  businessPartner BusinessPartner          @relation(fields: [businessPartnerId], references: [id])
  lines           RecurringExpenseLine[]
  runs            RecurringExpenseRun[]

  @@map("recurring_expenses")
}

model RecurringExpenseLine {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurringExpenseId String  @map("recurring_expense_id") @db.Uuid
  // Always a SERVICE item — the route rejects a STOCK one.
  itemId             String  @map("item_id") @db.Uuid
  quantity           Decimal @default(1) @db.Decimal(14, 3)
  // Null only when the parent template is PROMPTED.
  rate               Decimal? @db.Decimal(14, 2)
  taxRate            Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  sortOrder          Int     @default(0) @map("sort_order") @db.SmallInt

  recurringExpense RecurringExpense @relation(fields: [recurringExpenseId], references: [id])
  item             Item             @relation(fields: [itemId], references: [id])

  @@map("recurring_expense_lines")
}

// One row per template per month. The unique index is the real guard behind
// Phase 3's Post button: concurrent clicks collide here rather than
// double-booking a payable.
// ── Prepaid expenses ─────────────────────────────────────────────────────
// See migration_032. A Purchase Bill line marked prepaid debits Prepaid
// Expenses (1105) rather than the service item's own expense head, and this
// schedule releases it to that head one month at a time.
//
// Input tax credit is never scheduled — it attaches to the tax invoice date,
// so the full GST is claimed in the month the bill is booked and none of the
// amortization entries carry any. totalAmount is net of tax.

model PrepaidSchedule {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  branchId           String?   @map("branch_id") @db.Uuid
  // Nullable so a schedule can later be opened for a prepayment that predates
  // SmartERP and has no bill here. Nothing creates one that way yet.
  purchaseBillId     String?   @map("purchase_bill_id") @db.Uuid
  purchaseBillLineId String?   @unique @map("purchase_bill_line_id") @db.Uuid
  // This schedule's own card in the 1105 sub-ledger (bpType PREPAID), so the
  // GL balance of Prepaid Expenses breaks down schedule by schedule without
  // leaving the ledger — same arrangement as an Item's card under Inventory.
  businessPartnerId  String    @map("business_partner_id") @db.Uuid
  name               String    @db.VarChar(200)
  prepaidAccountId   String    @map("prepaid_account_id") @db.Uuid
  // Snapshot of the service item's expense account, not a live read of it.
  // Re-pointing the item later must change what future bills do, not redirect
  // the remaining instalments of a schedule already half-released.
  expenseAccountId   String    @map("expense_account_id") @db.Uuid
  totalAmount        Decimal   @map("total_amount") @db.Decimal(14, 2)
  // Pinned to the 1st, like RecurringExpense.startMonth.
  startMonth         DateTime  @map("start_month") @db.Date
  months             Int
  status             String    @default("ACTIVE") @db.VarChar(12)
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledBy        String?   @map("cancelled_by") @db.Uuid
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  purchaseBill     PurchaseBill?     @relation(fields: [purchaseBillId], references: [id])
  purchaseBillLine PurchaseBillLine? @relation(fields: [purchaseBillLineId], references: [id])
  businessPartner  BusinessPartner   @relation(fields: [businessPartnerId], references: [id])
  prepaidAccount   Account           @relation("PrepaidScheduleAsset", fields: [prepaidAccountId], references: [id])
  expenseAccount   Account           @relation("PrepaidScheduleExpense", fields: [expenseAccountId], references: [id])
  runs             PrepaidScheduleRun[]

  @@map("prepaid_schedules")
}

model PrepaidScheduleRun {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prepaidScheduleId String   @map("prepaid_schedule_id") @db.Uuid
  periodMonth       DateTime @map("period_month") @db.Date
  // 1-based. instalmentNo == months is the final, balancing slice.
  instalmentNo      Int      @map("instalment_no")
  amount            Decimal  @db.Decimal(14, 2)
  // Deliberately a scalar rather than a relation: nothing ever navigates from
  // a JournalEntry back to a prepaid run, and modelling it would put an
  // unused array on JournalEntry.
  journalEntryId    String   @map("journal_entry_id") @db.Uuid
  // AMORTIZATION is the normal monthly slice; WRITE_OFF is the single entry
  // that clears the remainder when a schedule is cancelled early.
  runType           String   @default("AMORTIZATION") @map("run_type") @db.VarChar(14)
  generatedBy       String?  @map("generated_by") @db.Uuid
  generatedAt       DateTime @default(now()) @map("generated_at")

  prepaidSchedule PrepaidSchedule @relation(fields: [prepaidScheduleId], references: [id])

  @@unique([prepaidScheduleId, periodMonth])
  @@map("prepaid_schedule_runs")
}

// ── Depreciation ─────────────────────────────────────────────────────────
// See migration_034. One register serves two statutes that never agree:
// Schedule II of the Companies Act drives the ledger (per asset, useful life,
// pro rata by day, residual value), Section 32 of the Income Tax Act drives
// the return (per block, prescribed WDV rate, half rate under 180 days, no
// residual). Only the first posts. The gap between them is what deferred tax
// accounts for — deliberately not computed here.

model AssetClass {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  name                    String   @db.VarChar(120)
  assetAccountId          String   @map("asset_account_id") @db.Uuid
  accumDepAccountId       String   @map("accum_dep_account_id") @db.Uuid
  depExpenseAccountId     String   @map("dep_expense_account_id") @db.Uuid
  defaultUsefulLifeMonths Int      @map("default_useful_life_months")
  // The life Schedule II actually prescribes, kept apart from the default
  // above because the default is editable and this is not. Part A paragraph
  // 3(i) measures a deviation against the statute, so editing a class must
  // never move the yardstick. See migration_035.
  // What the Companies Act prescribes. Editable, because the Act itself can
  // be amended — a yardstick that could not move would make every asset look
  // like a deviation the day it was. Editing it is a different act from
  // editing the policy life above, and rarer.
  scheduleIiLifeMonths    Int      @map("schedule_ii_life_months")
  // Part A paragraph 3(i)'s justification, for a POLICY life shorter than
  // the statute. It lives here rather than on each asset because shortening
  // Computers from 72 months to 36 is one decision, not one per computer;
  // every asset copies this at capitalisation. See migration_038.
  lifePolicyNote          String?  @map("life_policy_note") @db.VarChar(500)
  defaultMethod           String   @default("SLM") @map("default_method") @db.VarChar(3)
  // 5% is the Schedule II ceiling ("shall not be more than five per cent of
  // the original cost"), not a requirement — hence a default, not a constant.
  defaultResidualPct      Decimal  @default(5.00) @map("default_residual_pct") @db.Decimal(5, 2)
  defaultItBlockCode      String   @map("default_it_block_code") @db.VarChar(30)
  defaultItRate           Decimal  @map("default_it_rate") @db.Decimal(5, 2)
  isActive                Boolean  @default(true) @map("is_active")
  sortOrder               Int      @default(0) @map("sort_order")
  createdAt               DateTime @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id])
  assetAccount    Account      @relation("AssetClassCost", fields: [assetAccountId], references: [id])
  accumDepAccount Account      @relation("AssetClassAccumDep", fields: [accumDepAccountId], references: [id])
  depExpenseAccount Account    @relation("AssetClassExpense", fields: [depExpenseAccountId], references: [id])
  assets          FixedAsset[]
  items           Item[]
  methodChanges   DepreciationMethodChange[]

  @@unique([organizationId, name])
  @@map("asset_classes")
}

model FixedAsset {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  branchId              String?   @map("branch_id") @db.Uuid
  assetClassId          String    @map("asset_class_id") @db.Uuid
  // Nullable so an asset owned before SmartERP can be opened by hand. Nothing
  // creates one that way yet.
  purchaseBillId        String?   @map("purchase_bill_id") @db.Uuid
  purchaseBillLineId    String?   @unique @map("purchase_bill_line_id") @db.Uuid
  // This asset's card, tagged on BOTH balance-sheet accounts, so its gross
  // cost, accumulated depreciation and net book value are all readable from
  // the ledger itself rather than only from this table.
  businessPartnerId     String    @map("business_partner_id") @db.Uuid
  assetCode             String    @map("asset_code") @db.VarChar(30)
  name                  String    @db.VarChar(200)
  // Snapshots of the class's accounts, not live reads: re-pointing a class
  // later must change what future assets do, never redirect the remaining
  // charges of one already part-depreciated.
  assetAccountId        String    @map("asset_account_id") @db.Uuid
  accumDepAccountId     String    @map("accum_dep_account_id") @db.Uuid
  depExpenseAccountId   String    @map("dep_expense_account_id") @db.Uuid
  grossCost             Decimal   @map("gross_cost") @db.Decimal(14, 2)
  residualValue         Decimal   @default(0) @map("residual_value") @db.Decimal(14, 2)
  // Section 16(3): claim the input tax credit OR capitalise the GST and
  // depreciate it, never both. true means the GST sits inside grossCost.
  gstCapitalised        Boolean   @default(false) @map("gst_capitalised")
  purchaseDate          DateTime  @map("purchase_date") @db.Date
  // What depreciation runs from — Schedule II charges pro rata "from the date
  // of such addition", and an asset still in its crate is not in use.
  inUseDate             DateTime  @map("in_use_date") @db.Date
  // Schedule II prescribes lives, not methods — Part A never names one, and
  // Part C's Notes require only that the method used be disclosed. WDV must
  // carry a residual: its rate is 1 - (residual/cost)^(1/n), which at zero
  // residual writes the whole cost off in one period.
  method                String    @default("SLM") @db.VarChar(3)
  usefulLifeMonths      Int       @map("useful_life_months")
  // Snapshotted from the class at capitalisation, so the register can answer
  // "which assets depart from Schedule II" even after a class is edited.
  scheduleIiLifeMonths  Int       @map("schedule_ii_life_months")
  // Part A paragraph 3(i): a life different from the prescribed one must be
  // disclosed and justified with technical advice. NOT NULL is wrong here —
  // most assets do not deviate — so the requirement is a CHECK instead:
  // fixed_assets_life_note_ck refuses a deviation with no note.
  usefulLifeNote        String?   @map("useful_life_note") @db.VarChar(500)
  // Pinned per asset: block rates change with each Finance Act, and an asset
  // keeps computing at the rate it was capitalised under.
  itBlockCode           String    @map("it_block_code") @db.VarChar(30)
  itRate                Decimal   @map("it_rate") @db.Decimal(5, 2)
  status                String    @default("ACTIVE") @db.VarChar(20)
  disposalDate          DateTime? @map("disposal_date") @db.Date
  disposalProceeds      Decimal?  @map("disposal_proceeds") @db.Decimal(14, 2)
  disposalJournalEntryId String?  @map("disposal_journal_entry_id") @db.Uuid
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  deletedAt             DateTime? @map("deleted_at")

  organization      Organization      @relation(fields: [organizationId], references: [id])
  branch            Branch?           @relation(fields: [branchId], references: [id])
  assetClass        AssetClass        @relation(fields: [assetClassId], references: [id])
  purchaseBill      PurchaseBill?     @relation(fields: [purchaseBillId], references: [id])
  purchaseBillLine  PurchaseBillLine? @relation(fields: [purchaseBillLineId], references: [id])
  businessPartner   BusinessPartner   @relation(fields: [businessPartnerId], references: [id])
  assetAccount      Account           @relation("FixedAssetCost", fields: [assetAccountId], references: [id])
  accumDepAccount   Account           @relation("FixedAssetAccumDep", fields: [accumDepAccountId], references: [id])
  depExpenseAccount Account           @relation("FixedAssetExpense", fields: [depExpenseAccountId], references: [id])
  runs              FixedAssetDepreciationRun[]

  @@unique([organizationId, assetCode])
  @@map("fixed_assets")
}

// Every time the company changed its depreciation method, and why.
//
// Not an audit convenience — this is what the engine reads. The method in
// force for a month is the toMethod of the latest change effective on or
// before it, falling back to Organization.depreciationMethod. Reading it per
// month rather than stamping it onto each asset is what lets a change be
// dated forward without altering the months in between.
//
// reason is required: a change in accounting estimate has to be disclosed.
model DepreciationMethodChange {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // NULL means the change applies company-wide; an id scopes it to that one
  // asset class. Most companies use a single method, but a company may
  // reasonably depreciate plant on WDV and buildings on SLM provided the
  // policy note says which — see migration_039.
  assetClassId   String?  @map("asset_class_id") @db.Uuid
  fromMethod     String   @map("from_method") @db.VarChar(3)
  toMethod       String   @map("to_method") @db.VarChar(3)
  // First of the month the new method starts applying from.
  effectiveMonth DateTime @map("effective_month") @db.Date
  reason         String   @db.VarChar(500)
  changedBy      String?  @map("changed_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  assetClass   AssetClass?  @relation(fields: [assetClassId], references: [id])

  // Uniqueness is two PARTIAL indexes in migration_039 — one company-wide
  // change per month, one per class per month — which Prisma cannot express:
  // a plain unique over (org, class, month) would admit two company-wide
  // changes in a month, because Postgres treats NULLs as distinct.
  @@index([organizationId, assetClassId, effectiveMonth])
  @@map("depreciation_method_changes")
}

model DepreciationPeriod {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // A run is a thing that happened, so it gets a row. Which period has been
  // posted used to be inferred from max(period_start) across the charge rows,
  // which is wrong for a run whose charges all landed on EARLIER periods —
  // see migration_040. Inference replaced by a record.
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  frequency      String   @db.VarChar(12)
  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  assetCount     Int      @default(0) @map("asset_count")
  postedBy       String?  @map("posted_by") @db.Uuid
  postedAt       DateTime @default(now()) @map("posted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, periodStart], map: "dep_periods_org_start_uq")
  @@index([organizationId, periodEnd])
  @@map("depreciation_periods")
}

model FixedAssetDepreciationRun {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fixedAssetId   String   @map("fixed_asset_id") @db.Uuid
  // A PERIOD, not a month. An annual charge is one row covering twelve
  // months, not twelve rows summed — see migration_038. periodStart is
  // always the first of a month whichever frequency it belongs to.
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  // Recorded per run rather than read from the organization, because the
  // policy can change and a charge already posted has to stay explicable
  // under the frequency it was actually computed at.
  frequency      String   @db.VarChar(12)
  amount         Decimal  @db.Decimal(14, 2)
  // Stored, not recomputed on read. Under WDV each month depends on the one
  // before it, so recomputing an old figure from today's rules would rewrite
  // history — the same class of bug migration_031 fixed for GST.
  openingWdv     Decimal  @map("opening_wdv") @db.Decimal(14, 2)
  closingWdv     Decimal  @map("closing_wdv") @db.Decimal(14, 2)
  // A scalar rather than a relation: nothing navigates from a JournalEntry
  // back to a depreciation run, and modelling it would put an unused array on
  // JournalEntry.
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  // DISPOSAL_CATCHUP is the pro-rata charge up to a disposal date, posted
  // with the disposal rather than on the monthly run.
  runType        String   @default("MONTHLY") @map("run_type") @db.VarChar(20)
  generatedBy    String?  @map("generated_by") @db.Uuid
  generatedAt    DateTime @default(now()) @map("generated_at")

  fixedAsset FixedAsset @relation(fields: [fixedAssetId], references: [id])

  @@unique([fixedAssetId, periodStart])
  @@map("fixed_asset_depreciation_runs")
}

model RecurringExpenseRun {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurringExpenseId String   @map("recurring_expense_id") @db.Uuid
  periodMonth        DateTime @map("period_month") @db.Date
  purchaseBillId     String   @map("purchase_bill_id") @db.Uuid
  generatedAt        DateTime @default(now()) @map("generated_at")
  generatedBy        String?  @map("generated_by") @db.Uuid

  recurringExpense RecurringExpense @relation(fields: [recurringExpenseId], references: [id])
  purchaseBill     PurchaseBill     @relation(fields: [purchaseBillId], references: [id])

  @@unique([recurringExpenseId, periodMonth])
  @@map("recurring_expense_runs")
}