// Mirrors db/registration_schema_v2.sql. That SQL file (run directly via
// psql) is the source of truth for the actual DDL — it includes the
// trg_lock_org_domains trigger and CHECK constraints that Prisma's schema
// language can't express. This file exists so the backend gets a typed
// client; run `npx prisma generate` (no DB connection needed) after the SQL
// has been applied.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DomainType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  domainModules DomainModule[]
  coaTemplates  CoaTemplate[]
  orgDomains    OrgDomain[]

  @@map("domain_types")
}

model Module {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.VarChar(30)
  name String @db.VarChar(100)

  domainModules DomainModule[]
  orgModules    OrgModule[]

  @@map("modules")
}

model DomainModule {
  domainTypeId String  @map("domain_type_id") @db.Uuid
  moduleId     String  @map("module_id") @db.Uuid
  isDefault    Boolean @default(true) @map("is_default")

  domainType DomainType @relation(fields: [domainTypeId], references: [id])
  module     Module     @relation(fields: [moduleId], references: [id])

  @@id([domainTypeId, moduleId])
  @@map("domain_modules")
}

model CoaTemplate {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainTypeId     String? @map("domain_type_id") @db.Uuid
  accountCode      String  @map("account_code") @db.VarChar(10)
  accountName      String  @map("account_name") @db.VarChar(100)
  accountType      String  @map("account_type") @db.VarChar(20)
  isControlAccount Boolean @default(false) @map("is_control_account")
  defaultBpType    String? @map("default_bp_type") @db.VarChar(20)
  // Default Schedule III classification copied onto the Account row when
  // provisioning creates it from this template — see lib/provisioning.ts.
  // Null for INCOME/EXPENSE templates (Schedule III P&L formatting is a
  // separate, not-yet-built piece).
  scheduleIiiHead  String? @map("schedule_iii_head") @db.VarChar(40)

  domainType DomainType? @relation(fields: [domainTypeId], references: [id])

  @@unique([domainTypeId, accountCode])
  @@map("coa_templates")
}

model Organization {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String    @db.VarChar(200)
  status              String    @default("PENDING_VERIFICATION") @db.VarChar(20)
  subscriptionStatus  String    @default("ACTIVE") @map("subscription_status") @db.VarChar(20)
  // Weighted-average or FIFO stock valuation. Null until the org's first
  // Sales/Purchase/Inventory use — chosen once (lib/costing.ts enforces
  // this at the route level) and never editable after, because every
  // ItemStock/StockLot row that follows is computed under this rule.
  costingMethod       String?   @map("costing_method") @db.VarChar(20)
  // The company's depreciation policy. Schedule II prescribes useful lives,
  // not methods, so the method is the company's own choice, declared once and
  // disclosed. Changing it is a change in accounting estimate and applies
  // prospectively — see lib/depreciationPolicy.ts and migration_036.
  depreciationMethod String @default("SLM") @map("depreciation_method") @db.VarChar(3)
  // How often depreciation is charged. The amount for a year is the same
  // whichever this is; what changes is how many journal entries there are
  // and when the expense shows up in an interim P&L. Plenty of companies
  // compute it once at close. See migration_038.
  depreciationFrequency String @default("MONTHLY") @map("depreciation_frequency") @db.VarChar(12)
  // Below this, a capitalised line is expensed instead — nobody wants a
  // fixed asset carrying a forty-rupee monthly charge. Zero means no
  // threshold, which is what every organization starts with.
  capitalisationThreshold Decimal @default(0) @map("capitalisation_threshold") @db.Decimal(14, 2)
  domainLockedAt      DateTime? @map("domain_locked_at")
  // Company Master data — for statutory filings (AOC-4 etc.), not used by
  // any transactional posting anywhere. All nullable and unvalidated in
  // format (beyond length) since this app isn't the source of truth for
  // whether a CIN/PAN is actually well-formed — whoever files still needs
  // to check that. registeredOfficeAddress is a single free-text field in a
  // Json column, same convention Branch.address already uses.
  cin                     String?   @db.VarChar(21)
  companyPan              String?   @map("company_pan") @db.VarChar(10)
  companyType             String?   @map("company_type") @db.VarChar(30)
  incorporationDate       DateTime? @map("incorporation_date") @db.Date
  registeredOfficeAddress Json?     @map("registered_office_address")
  // Purchase Order approval workflow — null means "always require manual
  // approval" (the safe default). When set, a submitted PO whose
  // grandTotal is strictly below this amount auto-approves instead of
  // going to PENDING_APPROVAL. See routes/purchaseOrders.ts POST /:id/submit.
  poApprovalThreshold     Decimal?  @map("po_approval_threshold") @db.Decimal(14, 2)
  // 3-way match price tolerance — a PO-linked Purchase Bill line whose rate
  // differs from the PO line's rate by more than this percentage holds the
  // bill at PENDING_APPROVAL instead of posting immediately. Null (the
  // default) means 0% tolerance — any variance at all requires approval,
  // the safe default, same "null = most cautious" convention as
  // poApprovalThreshold above. See routes/purchaseBills.ts.
  priceVarianceTolerancePct Decimal? @map("price_variance_tolerance_pct") @db.Decimal(5, 2)
  // Sales Order approval workflow — the exact sales-side mirror of
  // poApprovalThreshold above. Null means "always require manual
  // approval". See routes/salesOrders.ts POST /:id/submit.
  soApprovalThreshold     Decimal?  @map("so_approval_threshold") @db.Decimal(14, 2)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  orgDomains       OrgDomain[]
  branches         Branch[]
  accounts         Account[]
  orgUsers         OrgUser[]
  orgRoles         OrgRole[]
  onboardingState  OnboardingState?
  orgModules       OrgModule[]
  items            Item[]
  bomLines         BomLine[]
  businessPartners BusinessPartner[]
  journalEntries   JournalEntry[]
  invites          OrgInvite[]
  auditLogs        AuditLog[]
  menuConfig       OrgMenuConfig[]
  salesInvoices    SalesInvoice[]
  purchaseBills    PurchaseBill[]
  recurringExpenses RecurringExpense[]
  prepaidSchedules PrepaidSchedule[]
  assetClasses     AssetClass[]
  fixedAssets      FixedAsset[]
  depreciationMethodChanges DepreciationMethodChange[]
  depreciationPeriods DepreciationPeriod[]
  stockAdjustments StockAdjustment[]
  salesReturns     SalesReturn[]
  purchaseReturns  PurchaseReturn[]
  stockMovements   StockMovement[]
  stockLots        StockLot[]
  directors        Director[]
  auditors         Auditor[]
  purchaseOrders   PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  salesOrders      SalesOrder[]
  deliveryNotes    DeliveryNote[]
  currencyRates    CurrencyRate[]
  integrationConnection IntegrationConnection?

  @@map("organizations")
}

// Service-to-service credential for an external system (currently just
// Project OS) to pull master data from and push pre-approved procurement
// documents into this organization — see routes/integrationConnections.ts
// (issues the key, user-JWT-gated OWNER/ADMIN) and routes/integrationApi.ts
// (the actual sync/push surface, gated by this key instead of a user
// session — middleware/serviceAuth.ts). One per org for now, matching the
// pilot's "one Project OS tenant per SmartERP tenant" assumption; calling
// POST /integration/connections again rotates it rather than allowing a
// second live key.
model IntegrationConnection {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @unique @map("organization_id") @db.Uuid
  apiKey         String    @unique @map("api_key") @db.VarChar(64)
  label          String?   @db.VarChar(100)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("integration_connections")
}

// Company Master — one row per director. History kept (isActive rather than
// delete) since AOC-4/MGT-7 style filings care about who held office during
// the filing period, not just who currently does.
model Director {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(150)
  din             String?   @db.VarChar(20)
  designation     String?   @db.VarChar(50) // e.g. "Director", "Managing Director", "Whole-time Director"
  appointmentDate DateTime? @map("appointment_date") @db.Date
  cessationDate   DateTime? @map("cessation_date") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("directors")
}

// One row per auditor appointment — same history-kept convention as
// Director above (a company changes auditors over its life; AOC-4 cares
// which one covered the filing year).
model Auditor {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  name                   String    @db.VarChar(150)
  membershipNumber       String?   @map("membership_number") @db.VarChar(20)
  firmRegistrationNumber String?   @map("firm_registration_number") @db.VarChar(20)
  appointmentDate        DateTime? @map("appointment_date") @db.Date
  tenureEndDate          DateTime? @map("tenure_end_date") @db.Date
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("auditors")
}

model OrgDomain {
  organizationId String   @map("organization_id") @db.Uuid
  domainTypeId   String   @map("domain_type_id") @db.Uuid
  domainDetails  Json?    @map("domain_details")
  addedAt        DateTime @default(now()) @map("added_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  domainType   DomainType   @relation(fields: [domainTypeId], references: [id])

  @@id([organizationId, domainTypeId])
  @@map("org_domains")
}

model Branch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String    @db.VarChar(20)
  name           String    @db.VarChar(200)
  gstin          String?   @db.VarChar(15)
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(255)
  address        Json?
  // GST state code (2 digits, e.g. "29" = Karnataka) — auto-parsed from
  // gstin when set, independently editable. Compared against the
  // counterparty's stateCode at Sales/Purchase posting time to decide
  // CGST+SGST (same state) vs IGST (different state).
  stateCode      String?   @map("state_code") @db.VarChar(2)
  isHeadOffice   Boolean   @default(false) @map("is_head_office")
  status         String    @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  organization   Organization   @relation(fields: [organizationId], references: [id])
  orgUsers       OrgUser[]
  itemStocks     ItemStock[]
  journalEntries JournalEntry[]
  stockLots      StockLot[]
  stockMovements StockMovement[]
  salesInvoices  SalesInvoice[]
  purchaseBills  PurchaseBill[]
  stockAdjustments StockAdjustment[]
  salesReturns     SalesReturn[]
  purchaseReturns  PurchaseReturn[]
  purchaseOrders   PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  salesOrders      SalesOrder[]
  deliveryNotes    DeliveryNote[]
  recurringExpenses RecurringExpense[]
  prepaidSchedules PrepaidSchedule[]
  fixedAssets      FixedAsset[]

  @@unique([organizationId, code])
  @@map("branches")
}

model Account {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  accountCode         String    @map("account_code") @db.VarChar(10)
  accountName         String    @map("account_name") @db.VarChar(100)
  accountType         String    @map("account_type") @db.VarChar(20)
  subType             String?   @map("sub_type") @db.VarChar(60)
  // Schedule III classification (Balance Sheet only — see
  // lib/scheduleIII.ts for the full catalog) — only meaningful for ASSET/
  // LIABILITY/EQUITY accounts, null for INCOME/EXPENSE and for anything not
  // classified yet. Separate from subType above (which nothing populates
  // today) rather than overloading it, since this one has an actual
  // controlled vocabulary the report groups by.
  scheduleIiiHead     String?   @map("schedule_iii_head") @db.VarChar(40)
  description         String?   @db.VarChar(255)
  sortOrder           Int       @default(0) @map("sort_order")
  parentId            String?   @map("parent_id") @db.Uuid
  isGroup             Boolean   @default(false) @map("is_group")
  isControlAccount    Boolean   @default(false) @map("is_control_account")
  defaultBpType       String?   @map("default_bp_type") @db.VarChar(20)
  isSystem            Boolean   @default(false) @map("is_system")
  isActive            Boolean   @default(true) @map("is_active")
  openingBalance      Decimal?  @map("opening_balance") @db.Decimal(14, 2)
  openingBalanceType  String?   @map("opening_balance_type") @db.VarChar(6)
  openingBalanceDate  DateTime? @map("opening_balance_date") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at")
  deletedAt           DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  parent       Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountHierarchy")
  journalLines JournalLine[]
  itemsUsingAsStockAccount Item[]
  // Two distinct roles on a prepaid schedule: the asset the bill debits, and
  // the expense head each instalment releases into. Named because Prisma
  // cannot tell two relations to the same model apart otherwise.
  prepaidSchedulesHeldHere   PrepaidSchedule[] @relation("PrepaidScheduleAsset")
  prepaidSchedulesReleasedTo PrepaidSchedule[] @relation("PrepaidScheduleExpense")
  // Three roles apiece on an asset class and on an asset: the cost account,
  // the accumulated-depreciation contra, and the expense head each charge
  // lands in. Named because Prisma cannot tell relations to the same model
  // apart otherwise.
  assetClassesCost     AssetClass[] @relation("AssetClassCost")
  assetClassesAccumDep AssetClass[] @relation("AssetClassAccumDep")
  assetClassesExpense  AssetClass[] @relation("AssetClassExpense")
  fixedAssetsCost      FixedAsset[] @relation("FixedAssetCost")
  fixedAssetsAccumDep  FixedAsset[] @relation("FixedAssetAccumDep")
  fixedAssetsExpense   FixedAsset[] @relation("FixedAssetExpense")

  @@unique([organizationId, accountCode])
  @@map("accounts")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String?   @db.VarChar(150)
  email            String?   @unique @db.VarChar(255)
  phone            String?   @unique @db.VarChar(20)
  passwordHash     String    @map("password_hash")
  isVerified       Boolean   @default(false) @map("is_verified")
  isPlatformAdmin  Boolean   @default(false) @map("is_platform_admin")
  // M-PIN login (SmartAppt Gold-style phone + OTP + 4-digit PIN) — set the
  // first time via /auth/mpin/set (after an OTP challenge, reusing the same
  // resetOtpCode/resetOtpExpiresAt pair below), then used directly via
  // /auth/mpin/verify for every login after that. Hashed with the same
  // bcrypt wrapper as passwordHash (lib/password.ts) — a 4-digit PIN hashed
  // the same way is just a much smaller keyspace, not a different scheme.
  // Null until the user has gone through the flow once; email/phone +
  // password (POST /auth/login) keeps working regardless, so this is
  // additive, not a replacement.
  mpinHash          String?   @map("mpin_hash")
  // Forgot-password flow — see /auth/forgot-password and /auth/reset-password.
  // Also reused by the M-PIN flow's OTP step (POST /auth/mpin/request-otp,
  // /auth/mpin/set) — same "one pending OTP per user" shape, doesn't need
  // its own separate pair of columns.
  resetOtpCode      String?   @map("reset_otp_code") @db.VarChar(10)
  resetOtpExpiresAt DateTime? @map("reset_otp_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  orgUsers     OrgUser[]
  invitesSent  OrgInvite[]  @relation("InvitedBy")
  auditLogs    AuditLog[]

  @@map("users")
}

model OrgInvite {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(20)
  role           String    @db.VarChar(20)
  // Set together with role = "CUSTOM" when the invite targets a
  // custom-defined role rather than one of the four fixed ones.
  customRoleId   String?   @map("custom_role_id") @db.Uuid
  invitedBy      String    @map("invited_by") @db.Uuid
  token          String    @unique @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  inviter      User         @relation("InvitedBy", fields: [invitedBy], references: [id])
  customRole   OrgRole?     @relation(fields: [customRoleId], references: [id])

  @@map("org_invites")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(50)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String?  @map("entity_id") @db.Uuid
  summary        String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}

model OrgUser {
  organizationId String  @map("organization_id") @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  role           String  @default("OWNER") @db.VarChar(20)
  // Set together with role = "CUSTOM" when this member holds an
  // org-defined role rather than one of the four fixed ones.
  customRoleId   String? @map("custom_role_id") @db.Uuid
  branchId       String? @map("branch_id") @db.Uuid
  // SUSPENDED blocks login/API use for this org without removing
  // membership — see PATCH /org/users/:userId/status.
  status         String  @default("ACTIVE") @db.VarChar(20)
  // Interim employee-details fields, OWNER/ADMIN-entered via the Team
  // screen — see migration_012's note on Aadhar's plaintext-at-rest caveat.
  // Not part of a separate Employee master (deferred); lives directly on
  // the membership row for now.
  address        String?
  pan            String? @db.VarChar(10)
  aadhar         String? @db.VarChar(12)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  customRole   OrgRole?     @relation(fields: [customRoleId], references: [id])

  @@id([organizationId, userId])
  @@map("org_users")
}

// Org-defined roles layered on top of the fixed OWNER/ADMIN/ACCOUNTANT/VIEWER
// four — see middleware/auth.ts's requirePermission() and
// lib/permissions.ts for how `permissions` (a subset of the fixed catalogue)
// gets enforced. Creating/editing/deleting these is OWNER/ADMIN-only
// (requireRole, not requirePermission) — see migration_009's note on why
// that's not itself a grantable permission.
model OrgRole {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(50)
  permissions    String[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  orgUsers     OrgUser[]
  orgInvites   OrgInvite[]

  @@unique([organizationId, name])
  @@map("org_roles")
}

// Sparse per-org, per-role menu overrides — see db/migration_005_menu_config.sql.
// itemId matches a NavItem.id in frontend/components/layout/navGroups.ts,
// which also carries each item's default `roles`; a row here only exists
// where an org has departed from that default.
model OrgMenuConfig {
  organizationId String   @map("organization_id") @db.Uuid
  itemId         String   @map("item_id") @db.VarChar(50)
  // Either a fixed role name ("ACCOUNTANT") or "custom:<org_roles.id>" for
  // a custom role — see migration_011_custom_role_access_control.sql.
  role           String   @db.VarChar(50)
  enabled        Boolean
  updatedAt      DateTime @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, itemId, role])
  @@map("org_menu_config")
}

model OnboardingState {
  organizationId String    @id @map("organization_id") @db.Uuid
  step           String    @default("SIGNUP") @db.VarChar(20)
  otpCode        String?   @map("otp_code") @db.VarChar(10)
  otpExpiresAt   DateTime? @map("otp_expires_at")
  provisionedAt  DateTime? @map("provisioned_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("onboarding_state")
}

// Per-org, per-module subscription standing — mirrors SmartAppt's
// AssociationModule (see subscriptions.routes.ts): a real grant/renew/cancel
// console, not a single org-wide on/off switch. `status` ACTIVE/TRIAL/
// CANCELLED, `expiresOn` null means perpetual, amount/reference/note are the
// billing record of what was actually granted and why.
model OrgModule {
  organizationId String    @map("organization_id") @db.Uuid
  moduleId       String    @map("module_id") @db.Uuid
  status         String    @default("ACTIVE") @map("status") @db.VarChar(20)
  startsOn       DateTime  @default(now()) @map("starts_on") @db.Date
  expiresOn      DateTime? @map("expires_on") @db.Date
  amount         Decimal?  @map("amount") @db.Decimal(10, 2)
  reference      String?   @map("reference") @db.VarChar(100)
  note           String?   @map("note")
  grantedBy      String?   @map("granted_by") @db.Uuid
  enabledAt      DateTime  @default(now()) @map("enabled_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  module       Module       @relation(fields: [moduleId], references: [id])

  @@id([organizationId, moduleId])
  @@map("org_modules")
}

model Item {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sku            String    @db.VarChar(50)
  name           String    @db.VarChar(200)
  description    String?   @db.VarChar(255)
  uom            String    @default("EA") @db.VarChar(20)
  hsnCode        String?   @map("hsn_code") @db.VarChar(10)
  isFinishedGood Boolean   @default(false) @map("is_finished_good")
  // STOCK (default) or SERVICE — see migration_029. A SERVICE item debits
  // an EXPENSE account and never moves stock; it exists so a GST-bearing
  // expense (rent, telecom, professional fees) can go through a Purchase
  // Bill and therefore show up as ITC, which lib/gstReports.ts only ever
  // sources from purchase_bills.
  itemKind       String    @default("STOCK") @map("item_kind") @db.VarChar(10)
  // The account this item posts against. For STOCK that's the control
  // account its stock value sits in — Inventory (Trading), Raw Materials or
  // Finished Goods (Manufacturing) — explicit rather than inferred from
  // isFinishedGood/domain, since an org that selected both domains has more
  // than one candidate. For SERVICE it's the EXPENSE account the bill line
  // debits. Deliberately not renamed: it would touch every existing row and
  // query for no functional gain.
  stockAccountId String    @map("stock_account_id") @db.Uuid
  // An item that is capital by nature — a conference table, a laptop — says
  // so here, once, instead of on every Purchase Bill line. A line for such
  // an item arrives capitalised against this class and can still be unticked
  // deliberately; what it can no longer be is unticked by omission, which is
  // the failure that puts an asset's cost in the P&L with no register entry.
  //
  // Only a SERVICE item may carry one: a STOCK item's purchase already moves
  // inventory. migration_037's CHECK enforces that from the database.
  defaultAssetClassId String? @map("default_asset_class_id") @db.Uuid
  // The paired sub-ledger row (business_partners.bp_type = 'ITEM') that
  // tags every journal line against stockAccountId for this item — same
  // pattern Trade Receivables/Payables already use for customers/vendors.
  // Created automatically alongside the item (see routes/items.ts), never
  // exposed as a separate thing to manage.
  businessPartnerId String @unique @map("business_partner_id") @db.Uuid
  salesRate      Decimal?  @map("sales_rate") @db.Decimal(14, 2)
  purchaseRate   Decimal?  @map("purchase_rate") @db.Decimal(14, 2)
  taxRate        Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  // Seeds a Sales Invoice line's discount % when this item is picked —
  // freely overridable on the line itself, same convention as
  // salesRate/taxRate.
  defaultDiscountPct Decimal @default(0) @map("default_discount_pct") @db.Decimal(5, 2)
  // Starting balance, same convention as Account.openingBalance /
  // BusinessPartner.openingBalance — a stored figure reports fold in
  // mathematically, not a posted document. Seeds ItemStock.averageCost
  // (weighted-avg orgs) or a single StockLot (FIFO orgs) the first time
  // this item is touched by a real movement.
  openingQuantity Decimal  @default(0) @map("opening_quantity") @db.Decimal(14, 4)
  openingCost     Decimal  @default(0) @map("opening_cost") @db.Decimal(14, 2)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  organization        Organization    @relation(fields: [organizationId], references: [id])
  stockAccount         Account         @relation(fields: [stockAccountId], references: [id])
  defaultAssetClass AssetClass? @relation(fields: [defaultAssetClassId], references: [id])
  businessPartner       BusinessPartner @relation(fields: [businessPartnerId], references: [id])
  itemStocks           ItemStock[]
  bomLinesAsFinished   BomLine[]       @relation("FinishedItem")
  bomLinesAsComponent  BomLine[]       @relation("ComponentItem")
  stockLots            StockLot[]
  stockMovements       StockMovement[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseBillLines    PurchaseBillLine[]
  stockAdjustmentLines StockAdjustmentLine[]
  salesReturnLines     SalesReturnLine[]
  purchaseReturnLines  PurchaseReturnLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptNoteLines GoodsReceiptNoteLine[]
  salesOrderLines      SalesOrderLine[]
  deliveryNoteLines    DeliveryNoteLine[]
  recurringExpenseLines RecurringExpenseLine[]

  @@unique([organizationId, sku])
  @@map("items")
}

model ItemStock {
  itemId         String   @map("item_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(14, 4)
  // Authoritative for weighted-average orgs; kept in sync (blended) for
  // FIFO orgs too so a quick read never has to walk StockLot, but the lots
  // are what FIFO consumption actually uses.
  averageCost    Decimal  @default(0) @map("average_cost") @db.Decimal(14, 4)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  item   Item   @relation(fields: [itemId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([itemId, branchId])
  @@map("item_stock")
}

// FIFO cost layers — one row per receipt (purchase, opening balance, or an
// inward adjustment), consumed oldest-first on every sale. Unused entirely
// for weighted-average orgs.
model StockLot {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  quantityRemaining Decimal @map("quantity_remaining") @db.Decimal(14, 4)
  unitCost       Decimal   @map("unit_cost") @db.Decimal(14, 4)
  receivedAt     DateTime  @map("received_at")
  referenceType  String?   @map("reference_type") @db.VarChar(30)
  referenceId    String?   @map("reference_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])

  @@map("stock_lots")
}

// The stock audit trail — every inward/outward movement, powers the Stock
// Ledger report the same way JournalLine powers the accounting Ledger.
model StockMovement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  movementType   String   @map("movement_type") @db.VarChar(20) // PURCHASE / SALE / ADJUSTMENT_IN / ADJUSTMENT_OUT
  quantity       Decimal  @db.Decimal(14, 4) // always positive; movementType carries direction
  unitCost       Decimal  @map("unit_cost") @db.Decimal(14, 4)
  referenceType  String?  @map("reference_type") @db.VarChar(30)
  referenceId    String?  @map("reference_id") @db.Uuid
  narration      String?  @db.VarChar(255)
  movementDate   DateTime @map("movement_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])

  @@map("stock_movements")
}

model SalesInvoice {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  branchId          String?  @map("branch_id") @db.Uuid
  businessPartnerId String   @map("business_partner_id") @db.Uuid
  invoiceNumber     String   @map("invoice_number") @db.VarChar(30)
  invoiceDate       DateTime @map("invoice_date") @db.Date
  narration         String   @default("") @db.VarChar(255)
  journalEntryId    String   @unique @map("journal_entry_id") @db.Uuid
  // Gross, pre-discount total (sum of qty*rate across lines) — Sales
  // Revenue posts here (gross method). Grand Total is still what the
  // customer actually owes.
  subtotal          Decimal  @db.Decimal(14, 2)
  taxTotal          Decimal  @map("tax_total") @db.Decimal(14, 2)
  grandTotal        Decimal  @map("grand_total") @db.Decimal(14, 2)
  totalCogs         Decimal  @map("total_cogs") @db.Decimal(14, 2)
  // Invoice-level discount, applied on top of each line's own discount and
  // prorated across lines — see routes/salesInvoices.ts.
  discountType      String?  @map("discount_type") @db.VarChar(10) // PERCENT | FLAT
  discountValue     Decimal  @default(0) @map("discount_value") @db.Decimal(14, 2)
  // Total discount actually applied — line-level + this invoice-level
  // discount's prorated share, combined. Posts to the Discount Allowed
  // contra-revenue account.
  discountTotal     Decimal  @default(0) @map("discount_total") @db.Decimal(14, 2)
  cgstTotal         Decimal  @default(0) @map("cgst_total") @db.Decimal(14, 2)
  sgstTotal         Decimal  @default(0) @map("sgst_total") @db.Decimal(14, 2)
  igstTotal         Decimal  @default(0) @map("igst_total") @db.Decimal(14, 2)
  // Foreign-currency support (exports) — see lib/currencies.ts. currency
  // stays "INR"/exchangeRate stays 1 for every domestic invoice, unchanged
  // from before this feature existed. grandTotalFc is a display-only
  // round2(grandTotal / exchangeRate) derivative — INR (above) remains the
  // sole figure GST/accounting/reports rely on.
  currency          String   @default("INR") @db.VarChar(3)
  exchangeRate      Decimal  @default(1) @map("exchange_rate") @db.Decimal(12, 6)
  grandTotalFc      Decimal? @map("grand_total_fc") @db.Decimal(14, 2)
  // Export declaration — only set when currency != "INR" (see
  // routes/salesInvoices.ts). "LUT" | "BOND" | "WPAY" (with payment of
  // IGST, tax charged then claimed back as refund). LUT/BOND exports are
  // zero-rated by law — the server rejects any line with a nonzero taxRate
  // when exportType is LUT/BOND rather than silently zeroing it.
  exportType        String?  @map("export_type") @db.VarChar(10)
  lutBondNumber     String?  @map("lut_bond_number") @db.VarChar(40)
  lutBondDate       DateTime? @map("lut_bond_date") @db.Date
  // Shipping bill (GSTR-1 Table 6A needs this) and port code — almost
  // always unknown at the moment of invoicing (goods ship after the
  // invoice is raised), so these stay nullable and are filled in later via
  // PATCH rather than required at POST time. Freeform, not validated
  // against ICEGATE's port code list — see routes/salesInvoices.ts.
  shippingBillNumber String?  @map("shipping_bill_number") @db.VarChar(30)
  shippingBillDate   DateTime? @map("shipping_bill_date") @db.Date
  portCode           String?  @map("port_code") @db.VarChar(10)
  // Optional — set when this invoice was raised against an approved Sales
  // Order rather than created standalone. See routes/salesInvoices.ts: when
  // present, businessPartnerId is derived from the SO (not taken from the
  // request), and every line must carry its own deliveryNoteLineId (3-way
  // qty match — see SalesInvoiceLine below); none of this invoice's lines
  // call consumeStock, since the linked Delivery Note(s) already moved that
  // stock out (their captured unitCost is reused for the COGS journal
  // line instead). An invoice with no salesOrderId is unaffected by any of
  // this — it still moves its own stock exactly as it did before this
  // feature.
  salesOrderId       String?  @map("sales_order_id") @db.Uuid
  // Customer identity as it stood when this invoice was posted — see
  // migration_031. GSTR-1 reads these, never the master, so correcting a
  // customer record cannot restate a period already filed with the GSTN.
  // partyStateCode is the place of supply and also decides B2B vs B2C
  // (via partyGstin) and CGST+SGST vs IGST, so all three must be pinned
  // together or the document contradicts itself.
  partyGstin        String?  @map("party_gstin") @db.VarChar(15)
  partyName         String?  @map("party_name") @db.VarChar(200)
  partyStateCode    String?  @map("party_state_code") @db.VarChar(2)
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization       @relation(fields: [organizationId], references: [id])
  branch          Branch?            @relation(fields: [branchId], references: [id])
  businessPartner BusinessPartner    @relation(fields: [businessPartnerId], references: [id])
  journalEntry    JournalEntry       @relation(fields: [journalEntryId], references: [id])
  salesOrder      SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  lines           SalesInvoiceLine[]
  returns         SalesReturn[]

  @@unique([organizationId, invoiceNumber])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesInvoiceId String  @map("sales_invoice_id") @db.Uuid
  itemId         String  @map("item_id") @db.Uuid
  quantity       Decimal @db.Decimal(14, 4)
  rate           Decimal @db.Decimal(14, 2)
  taxRate        Decimal @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal   Decimal @map("line_subtotal") @db.Decimal(14, 2) // gross, qty*rate, pre-discount
  taxAmount      Decimal @map("tax_amount") @db.Decimal(14, 2) // cgstAmount + sgstAmount + igstAmount
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2) // taxableValue + taxAmount
  unitCost       Decimal @map("unit_cost") @db.Decimal(14, 4) // cost consumed for this line, snapshotted at posting
  lineCogs       Decimal @map("line_cogs") @db.Decimal(14, 2)
  // This line's own discount (item-default-seeded, freely overridden).
  discountType         String?  @map("discount_type") @db.VarChar(10) // PERCENT | FLAT
  discountValue        Decimal  @default(0) @map("discount_value") @db.Decimal(14, 2)
  lineDiscountAmount    Decimal  @default(0) @map("line_discount_amount") @db.Decimal(14, 2)
  // Prorated share of the invoice-level discount — see routes/salesInvoices.ts.
  invoiceDiscountShare  Decimal  @default(0) @map("invoice_discount_share") @db.Decimal(14, 2)
  // lineSubtotal - lineDiscountAmount - invoiceDiscountShare — what GST is
  // actually computed on.
  taxableValue          Decimal  @default(0) @map("taxable_value") @db.Decimal(14, 2)
  cgstAmount            Decimal  @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount            Decimal  @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount            Decimal  @default(0) @map("igst_amount") @db.Decimal(14, 2)
  // rateFc: unit rate as entered, in the invoice's currency (null for INR
  // invoices — `rate` above is already the only figure that exists then).
  // lineTotalFc: display-only round2(lineTotal / exchangeRate).
  rateFc                Decimal? @map("rate_fc") @db.Decimal(14, 4)
  lineTotalFc           Decimal? @map("line_total_fc") @db.Decimal(14, 2)
  // Only meaningful when the parent invoice has a salesOrderId — mirrors
  // purchaseOrderLineId/goodsReceiptNoteLineId on PurchaseBillLine exactly.
  // salesOrderLineId feeds the SalesOrderLine.billedQuantity rollup (and PO
  // auto-close); deliveryNoteLineId is the actual 3-way match enforcement
  // point (this line's quantity can never exceed what's still unbilled on
  // that Delivery Note line).
  salesOrderLineId     String?  @map("sales_order_line_id") @db.Uuid
  deliveryNoteLineId   String?  @map("delivery_note_line_id") @db.Uuid
  // Item identity at posting time, for GSTR-1's HSN summary — see
  // migration_031. Same reasoning as unitCost above: correcting an item's
  // HSN code should describe goods sold from now on, not rewrite what was
  // already declared.
  hsnCode              String?  @map("hsn_code") @db.VarChar(10)
  itemName             String?  @map("item_name") @db.VarChar(200)
  uom                  String?  @db.VarChar(20)

  salesInvoice     SalesInvoice      @relation(fields: [salesInvoiceId], references: [id])
  item             Item              @relation(fields: [itemId], references: [id])
  returnLines      SalesReturnLine[]
  salesOrderLine   SalesOrderLine?   @relation(fields: [salesOrderLineId], references: [id])
  deliveryNoteLine DeliveryNoteLine? @relation(fields: [deliveryNoteLineId], references: [id])

  @@map("sales_invoice_lines")
}

model PurchaseBill {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  branchId          String?  @map("branch_id") @db.Uuid
  businessPartnerId String   @map("business_partner_id") @db.Uuid
  billNumber        String   @map("bill_number") @db.VarChar(30)
  billDate          DateTime @map("bill_date") @db.Date
  narration         String   @default("") @db.VarChar(255)
  // Nullable — a bill held at PENDING_APPROVAL (3-way-match price variance;
  // see status below) hasn't posted yet, so has no journal entry until
  // POST /purchase-bills/:id/approve actually creates one.
  journalEntryId    String?  @unique @map("journal_entry_id") @db.Uuid
  // POSTED (default — immediate posting, exactly how every bill worked
  // before this field existed) | PENDING_APPROVAL (PO-linked bill whose
  // rate varies from the PO by more than Organization.priceVarianceTolerancePct
  // — held with no journal entry, no stock movement, no billedQuantity
  // impact until approved) | REJECTED (terminal — never posts; the record
  // stays for audit, correct the numbers on a fresh bill instead. This app
  // has no bill-edit capability, matching the existing convention that a
  // posted-style document here is never revised in place). See
  // routes/purchaseBills.ts and ROADMAP.md's "3-Way Match" section.
  status            String    @default("POSTED") @db.VarChar(20)
  approvedBy        String?   @map("approved_by") @db.Uuid
  approvedAt        DateTime? @map("approved_at")
  rejectedBy        String?   @map("rejected_by") @db.Uuid
  rejectedAt        DateTime? @map("rejected_at")
  rejectionReason   String?   @map("rejection_reason") @db.VarChar(500)
  // Server-generated (never user-entered) — which line(s) exceeded the
  // price tolerance and by how much, shown on the Pending Approval detail
  // screen so the approver doesn't have to cross-reference the PO by hand.
  varianceNote      String?   @map("variance_note") @db.VarChar(500)
  subtotal          Decimal  @db.Decimal(14, 2)
  taxTotal          Decimal  @map("tax_total") @db.Decimal(14, 2)
  grandTotal        Decimal  @map("grand_total") @db.Decimal(14, 2)
  cgstTotal         Decimal  @default(0) @map("cgst_total") @db.Decimal(14, 2)
  sgstTotal         Decimal  @default(0) @map("sgst_total") @db.Decimal(14, 2)
  igstTotal         Decimal  @default(0) @map("igst_total") @db.Decimal(14, 2)
  // Foreign-currency support (imports) — see lib/currencies.ts and the
  // matching note on SalesInvoice above; same semantics.
  currency          String   @default("INR") @db.VarChar(3)
  exchangeRate      Decimal  @default(1) @map("exchange_rate") @db.Decimal(12, 6)
  grandTotalFc      Decimal? @map("grand_total_fc") @db.Decimal(14, 2)
  // Bill of Entry (customs clearance doc) and port code — same rationale
  // as SalesInvoice.shippingBillNumber above: usually unknown at posting
  // time, filled in later via PATCH. Also what a real ITC claim on an
  // import would eventually need to reference (not built yet — this pass
  // is just capturing the reference fields).
  billOfEntryNumber String?  @map("bill_of_entry_number") @db.VarChar(30)
  billOfEntryDate   DateTime? @map("bill_of_entry_date") @db.Date
  portCode          String?  @map("port_code") @db.VarChar(10)
  // Basic Customs Duty (non-creditable — folds into landed cost, never
  // touches a GST account) — only nonzero on a foreign-currency bill. See
  // routes/purchaseBills.ts for the full posting split: Trade Payables
  // (vendor) only ever gets `subtotal` on an import; customsDutyTotal +
  // taxTotal both credit the new Customs Duty Payable account instead,
  // since neither is actually owed to the vendor.
  customsDutyTotal  Decimal  @default(0) @map("customs_duty_total") @db.Decimal(14, 2)
  // Optional — set when this bill was raised against an approved Purchase
  // Order rather than created standalone. See routes/purchaseBills.ts:
  // when present, businessPartnerId is derived from the PO (not taken from
  // the request), and every line must carry its own
  // goodsReceiptNoteLineId (3-way match — see PurchaseBillLine below);
  // none of this bill's lines call receiveStock, since the linked GRN(s)
  // already moved that stock in. A bill with no purchaseOrderId is
  // unaffected by any of this — it still moves its own stock exactly as
  // it did before the Goods Receipt Note feature.
  purchaseOrderId   String?  @map("purchase_order_id") @db.Uuid
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization       @relation(fields: [organizationId], references: [id])
  branch          Branch?            @relation(fields: [branchId], references: [id])
  businessPartner BusinessPartner    @relation(fields: [businessPartnerId], references: [id])
  journalEntry    JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  lines           PurchaseBillLine[]
  returns         PurchaseReturn[]
  recurringExpenseRuns RecurringExpenseRun[]
  prepaidSchedules PrepaidSchedule[]
  fixedAssets      FixedAsset[]

  @@unique([organizationId, billNumber])
  @@map("purchase_bills")
}

model PurchaseBillLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseBillId String  @map("purchase_bill_id") @db.Uuid
  itemId         String  @map("item_id") @db.Uuid
  quantity       Decimal @db.Decimal(14, 4)
  rate           Decimal @db.Decimal(14, 2)
  taxRate        Decimal @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal   Decimal @map("line_subtotal") @db.Decimal(14, 2)
  taxAmount      Decimal @map("tax_amount") @db.Decimal(14, 2) // cgstAmount + sgstAmount + igstAmount
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)
  cgstAmount     Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount     Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  rateFc         Decimal? @map("rate_fc") @db.Decimal(14, 4)
  lineTotalFc    Decimal? @map("line_total_fc") @db.Decimal(14, 2)
  // Basic Customs Duty — entered as a % of this line's INR taxable value
  // (customsDutyRate), computed into customsDutyAmount, folded straight
  // into landed unit cost (see receiveStock's unitCost in
  // routes/purchaseBills.ts) and into the IGST base (IGST on an import is
  // charged on goods value + duty, not goods value alone). Both null/0 on
  // a domestic bill.
  customsDutyRate   Decimal? @map("customs_duty_rate") @db.Decimal(5, 2)
  customsDutyAmount Decimal  @default(0) @map("customs_duty_amount") @db.Decimal(14, 2)
  // Optional — which PurchaseOrderLine this bill line fulfills, when the
  // bill was raised from a PO. See routes/purchaseBills.ts: on post, this
  // line's quantity is added to that PurchaseOrderLine.billedQuantity.
  purchaseOrderLineId String? @map("purchase_order_line_id") @db.Uuid
  // Optional — which GoodsReceiptNoteLine this bill line fulfills. Required
  // by the route (not the schema) whenever the parent bill has a
  // purchaseOrderId — the 3-way match: this line can't bill more than
  // (that GRN line's quantityReceived − its own billedQuantity so far),
  // and receiveStock is *not* called for it, since the GRN already moved
  // that stock in. Null on every ad-hoc (non-PO) bill line, which keeps
  // moving its own stock exactly as before this feature existed.
  goodsReceiptNoteLineId String? @map("goods_receipt_note_line_id") @db.Uuid

  purchaseBill      PurchaseBill          @relation(fields: [purchaseBillId], references: [id])
  item              Item                  @relation(fields: [itemId], references: [id])
  purchaseOrderLine PurchaseOrderLine?    @relation(fields: [purchaseOrderLineId], references: [id])
  goodsReceiptNoteLine GoodsReceiptNoteLine? @relation(fields: [goodsReceiptNoteLineId], references: [id])
  returnLines       PurchaseReturnLine[]
  prepaidSchedule   PrepaidSchedule?
  fixedAsset        FixedAsset?

  @@map("purchase_bill_lines")
}

// ── Purchase Order ───────────────────────────────────────────────────────
// A pre-commitment document with its own approval workflow, entirely
// separate from posting — a PurchaseOrder never touches the journal or
// stock itself. Only once it's APPROVED can goods be received against it
// (GoodsReceiptNote, below — this is what actually moves stock) and one
// or more Purchase Bills raised (routes/purchaseBills.ts), which still
// does all the real accounting work exactly as it always has. See
// ROADMAP.md's "Purchase Order Workflow" / "Goods Receipt Note" sections
// for the full state machine.
//
// Status values: DRAFT (freely editable) -> submit ->
// APPROVED (auto, when grandTotal is below Organization.poApprovalThreshold)
//   or PENDING_APPROVAL (needs a purchase.approve holder) -> approve -> APPROVED
//                                                          -> reject -> REJECTED
// REJECTED -> reopen -> DRAFT (editable again, resubmittable)
// DRAFT/PENDING_APPROVAL/APPROVED(nothing received or billed yet) -> cancel -> CANCELLED
// APPROVED -> (every line fully billed) -> CLOSED, automatically
model PurchaseOrder {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  branchId          String?   @map("branch_id") @db.Uuid
  businessPartnerId String    @map("business_partner_id") @db.Uuid
  poNumber          String    @map("po_number") @db.VarChar(30)
  poDate            DateTime  @map("po_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  narration         String    @default("") @db.VarChar(255)
  status            String    @default("DRAFT") @db.VarChar(20)
  subtotal          Decimal   @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal   @default(0) @map("tax_total") @db.Decimal(14, 2)
  grandTotal        Decimal   @default(0) @map("grand_total") @db.Decimal(14, 2)
  // Foreign-currency support (import POs) — see lib/currencies.ts and the
  // matching note on PurchaseBill/SalesInvoice; identical semantics.
  // grandTotal (INR, above) stays the sole figure the approval threshold,
  // GRN unit cost, and every other downstream computation reads —
  // grandTotalFc is a display-only round2(grandTotal / exchangeRate)
  // derivative, same convention as everywhere else this pattern is used.
  // A Purchase Bill raised against this PO derives its own currency from
  // here (see routes/purchaseBills.ts) rather than choosing independently.
  currency          String    @default("INR") @db.VarChar(3)
  exchangeRate      Decimal   @default(1) @map("exchange_rate") @db.Decimal(12, 6)
  grandTotalFc      Decimal?  @map("grand_total_fc") @db.Decimal(14, 2)

  submittedBy    String?   @map("submitted_by") @db.Uuid
  submittedAt    DateTime? @map("submitted_at")
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  // True when APPROVED was reached automatically via poApprovalThreshold
  // rather than a human clicking Approve — kept for the audit trail shown
  // on the PO detail screen.
  autoApproved   Boolean   @default(false) @map("auto_approved")
  rejectedBy     String?   @map("rejected_by") @db.Uuid
  rejectedAt     DateTime? @map("rejected_at")
  rejectionReason String?  @map("rejection_reason") @db.VarChar(500)
  cancelledBy    String?   @map("cancelled_by") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Project OS integration (PRD Section 9.2 shadow-PO decision) — a PO
  // pushed in already-approved from Project OS carries source=PROJECT_OS
  // and externalId = Project OS's own PurchaseOrder.id, so a retried push
  // (e.g. after a dropped response) is detected and returns the existing
  // record instead of creating a duplicate. Native, in-app POs leave all
  // three null/default — Postgres treats multiple NULLs in a unique index
  // as distinct, so they never collide with each other or with pushed rows.
  source         String    @default("SMARTERP") @db.VarChar(20) // SMARTERP | PROJECT_OS
  externalSystem String?   @map("external_system") @db.VarChar(20)
  externalId     String?   @map("external_id") @db.Uuid

  organization    Organization        @relation(fields: [organizationId], references: [id])
  branch          Branch?             @relation(fields: [branchId], references: [id])
  businessPartner BusinessPartner     @relation(fields: [businessPartnerId], references: [id])
  lines           PurchaseOrderLine[]
  purchaseBills   PurchaseBill[]
  goodsReceiptNotes GoodsReceiptNote[]

  @@unique([organizationId, poNumber])
  @@unique([organizationId, externalSystem, externalId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  itemId          String  @map("item_id") @db.Uuid
  quantity        Decimal @db.Decimal(14, 4)
  rate            Decimal @db.Decimal(14, 2)
  taxRate         Decimal @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal    Decimal @map("line_subtotal") @db.Decimal(14, 2)
  taxAmount       Decimal @map("tax_amount") @db.Decimal(14, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(14, 2)
  // rateFc: unit rate as entered, in the PO's currency (null for INR POs —
  // `rate` above is already the only figure that exists then, exactly the
  // PurchaseBillLine/SalesInvoiceLine convention). `rate` itself stays the
  // authoritative INR figure (round2(rateFc * exchangeRate)) either way,
  // so GRN unitCost sourcing (routes/goodsReceiptNotes.ts reads
  // PurchaseOrderLine.rate directly) needs no change at all — stock
  // valuation stays INR-only regardless of the PO's own currency.
  // lineTotalFc: display-only round2(lineTotal / exchangeRate).
  rateFc          Decimal? @map("rate_fc") @db.Decimal(14, 4)
  lineTotalFc     Decimal? @map("line_total_fc") @db.Decimal(14, 2)
  // Running total of quantity already received against this line across
  // every Goods Receipt Note — see routes/goodsReceiptNotes.ts. Never
  // exceeds `quantity` (enforced server-side at GRN-post time). This is
  // the actual stock-in signal; billedQuantity below tracks the separate,
  // always-lagging-or-equal financial side.
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 4)
  // Running total of quantity already billed against this line across every
  // linked Purchase Bill — see routes/purchaseBills.ts. Never exceeds
  // `quantity` (enforced server-side at bill-post time). Bills against a
  // PO are additionally checked, per line, against that line's own
  // GoodsReceiptNoteLine.quantityReceived (the 3-way match) — this field
  // is the PO-level rollup used to decide when the whole PO can CLOSE.
  billedQuantity  Decimal @default(0) @map("billed_quantity") @db.Decimal(14, 4)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  item          Item               @relation(fields: [itemId], references: [id])
  purchaseBillLines PurchaseBillLine[]
  goodsReceiptNoteLines GoodsReceiptNoteLine[]

  @@map("purchase_order_lines")
}

// ── Goods Receipt Note ───────────────────────────────────────────────────
// Records the physical receipt of goods against an APPROVED Purchase
// Order — this, not the eventual Purchase Bill, is what actually moves
// stock (see lib/costing.ts receiveStock, called from
// routes/goodsReceiptNotes.ts). A GRN posts immediately on creation, the
// same create-and-post-in-one-step UX as a Purchase Bill — no draft/
// approval workflow of its own (that already happened at the PO stage; a
// GRN just confirms what physically arrived, and by whom it was
// received/checked in).
//
// Only meaningful in the PO-linked procurement path — see the note on
// PurchaseBill.purchaseOrderId. A Purchase Bill raised without a PO never
// touches a GoodsReceiptNote and keeps moving its own stock exactly as it
// always has.
model GoodsReceiptNote {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  businessPartnerId String   @map("business_partner_id") @db.Uuid
  purchaseOrderId   String   @map("purchase_order_id") @db.Uuid
  grnNumber         String   @map("grn_number") @db.VarChar(30)
  grnDate           DateTime @map("grn_date") @db.Date
  narration         String   @default("") @db.VarChar(255)
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  // Same Project OS integration convention as PurchaseOrder above — see
  // that model's comment.
  source         String  @default("SMARTERP") @db.VarChar(20) // SMARTERP | PROJECT_OS
  externalSystem String? @map("external_system") @db.VarChar(20)
  externalId     String? @map("external_id") @db.Uuid

  organization    Organization           @relation(fields: [organizationId], references: [id])
  branch          Branch                 @relation(fields: [branchId], references: [id])
  businessPartner BusinessPartner        @relation(fields: [businessPartnerId], references: [id])
  purchaseOrder   PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id])
  lines           GoodsReceiptNoteLine[]

  @@unique([organizationId, grnNumber])
  @@unique([organizationId, externalSystem, externalId])
  @@map("goods_receipt_notes")
}

model GoodsReceiptNoteLine {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goodsReceiptNoteId  String  @map("goods_receipt_note_id") @db.Uuid
  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  itemId              String  @map("item_id") @db.Uuid
  quantityReceived    Decimal @map("quantity_received") @db.Decimal(14, 4)
  // Carried in at the PO line's own rate — a GRN doesn't introduce a new
  // price, it just confirms quantity physically arrived. Any real price
  // variance found later is a Purchase Bill/vendor-invoice concern, out of
  // scope here (see ROADMAP.md).
  unitCost            Decimal @map("unit_cost") @db.Decimal(14, 2)
  // Running total of quantity already billed against this specific GRN
  // line — see routes/purchaseBills.ts. Never exceeds quantityReceived
  // (enforced server-side at bill-post time) — this is the 3-way match.
  billedQuantity      Decimal @default(0) @map("billed_quantity") @db.Decimal(14, 4)

  goodsReceiptNote  GoodsReceiptNote   @relation(fields: [goodsReceiptNoteId], references: [id])
  purchaseOrderLine PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  purchaseBillLines PurchaseBillLine[]

  @@map("goods_receipt_note_lines")
}

// ── Sales Order ──────────────────────────────────────────────────────────
// The sales-side mirror of PurchaseOrder — same status state machine:
// DRAFT -> submit -> APPROVED (auto, when soApprovalThreshold is set and
// this SO's grandTotal is strictly below it) or PENDING_APPROVAL ->
// approve/reject -> APPROVED/REJECTED. REJECTED -> reopen -> DRAFT (history
// kept, not cleared). Cancel blocks if anything's been delivered or
// billed. Auto-CLOSED once every line is fully billed. Never touches the
// journal or stock itself — purely a pre-commitment/approval document,
// same as PurchaseOrder. See routes/salesOrders.ts.
model SalesOrder {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  branchId          String?   @map("branch_id") @db.Uuid
  businessPartnerId String    @map("business_partner_id") @db.Uuid
  soNumber          String    @map("so_number") @db.VarChar(30)
  soDate            DateTime  @map("so_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  narration         String    @default("") @db.VarChar(255)
  status            String    @default("DRAFT") @db.VarChar(20)
  subtotal          Decimal   @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal   @default(0) @map("tax_total") @db.Decimal(14, 2)
  grandTotal        Decimal   @default(0) @map("grand_total") @db.Decimal(14, 2)
  // Foreign-currency support (export SOs) — exact mirror of
  // PurchaseOrder.currency/exchangeRate/grandTotalFc above. A Sales
  // Invoice raised against this SO derives its own currency from here
  // (see routes/salesInvoices.ts) rather than choosing independently.
  currency          String    @default("INR") @db.VarChar(3)
  exchangeRate      Decimal   @default(1) @map("exchange_rate") @db.Decimal(12, 6)
  grandTotalFc      Decimal?  @map("grand_total_fc") @db.Decimal(14, 2)

  submittedBy    String?   @map("submitted_by") @db.Uuid
  submittedAt    DateTime? @map("submitted_at")
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  // True when APPROVED was reached automatically via soApprovalThreshold
  // rather than a human clicking Approve — same audit-trail convention as
  // PurchaseOrder.autoApproved.
  autoApproved   Boolean   @default(false) @map("auto_approved")
  rejectedBy     String?   @map("rejected_by") @db.Uuid
  rejectedAt     DateTime? @map("rejected_at")
  rejectionReason String?  @map("rejection_reason") @db.VarChar(500)
  cancelledBy    String?   @map("cancelled_by") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  branch          Branch?          @relation(fields: [branchId], references: [id])
  businessPartner BusinessPartner  @relation(fields: [businessPartnerId], references: [id])
  lines           SalesOrderLine[]
  salesInvoices   SalesInvoice[]
  deliveryNotes   DeliveryNote[]

  @@unique([organizationId, soNumber])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesOrderId String  @map("sales_order_id") @db.Uuid
  itemId       String  @map("item_id") @db.Uuid
  quantity     Decimal @db.Decimal(14, 4)
  rate         Decimal @db.Decimal(14, 2)
  taxRate      Decimal @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal Decimal @map("line_subtotal") @db.Decimal(14, 2)
  taxAmount    Decimal @map("tax_amount") @db.Decimal(14, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(14, 2)
  // rateFc/lineTotalFc — exact mirror of PurchaseOrderLine's fields above.
  // `rate` stays the authoritative INR figure either way, so DeliveryNote's
  // sourcing of its own (purely descriptive) `rate` from this SO line
  // needs no change — see the schema comment on DeliveryNoteLine.rate.
  rateFc       Decimal? @map("rate_fc") @db.Decimal(14, 4)
  lineTotalFc  Decimal? @map("line_total_fc") @db.Decimal(14, 2)
  // Running total of quantity already dispatched against this line across
  // every Delivery Note — see routes/deliveryNotes.ts. Never exceeds
  // `quantity` (enforced server-side at delivery-note-post time). This is
  // the actual stock-out signal; billedQuantity below tracks the separate,
  // always-lagging-or-equal financial side.
  deliveredQuantity Decimal @default(0) @map("delivered_quantity") @db.Decimal(14, 4)
  // Running total of quantity already invoiced against this line across
  // every linked Sales Invoice — see routes/salesInvoices.ts. Never exceeds
  // `quantity` (enforced server-side at invoice-post time). Invoices
  // against an SO are additionally checked, per line, against that line's
  // own DeliveryNoteLine.quantityDelivered (the 3-way match) — this field
  // is the SO-level rollup used to decide when the whole SO can CLOSE.
  billedQuantity    Decimal @default(0) @map("billed_quantity") @db.Decimal(14, 4)

  salesOrder        SalesOrder         @relation(fields: [salesOrderId], references: [id])
  item               Item               @relation(fields: [itemId], references: [id])
  salesInvoiceLines  SalesInvoiceLine[]
  deliveryNoteLines  DeliveryNoteLine[]

  @@map("sales_order_lines")
}

// ── Delivery Note ────────────────────────────────────────────────────────
// Records the physical dispatch of goods against an APPROVED Sales Order —
// this, not the eventual Sales Invoice, is what actually moves stock (see
// lib/costing.ts consumeStock, called from routes/deliveryNotes.ts). A
// Delivery Note posts immediately on creation, the same create-and-post-
// in-one-step UX as a Sales Invoice — no draft/approval workflow of its
// own (that already happened at the SO stage; a Delivery Note just
// confirms what physically shipped).
//
// Only meaningful in the SO-linked sales path — see the note on
// SalesInvoice.salesOrderId. A Sales Invoice raised without an SO never
// touches a DeliveryNote and keeps moving its own stock exactly as it
// always has.
model DeliveryNote {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  businessPartnerId String   @map("business_partner_id") @db.Uuid
  salesOrderId      String   @map("sales_order_id") @db.Uuid
  dnNumber          String   @map("dn_number") @db.VarChar(30)
  dnDate            DateTime @map("dn_date") @db.Date
  narration         String   @default("") @db.VarChar(255)
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization       @relation(fields: [organizationId], references: [id])
  branch          Branch             @relation(fields: [branchId], references: [id])
  businessPartner BusinessPartner    @relation(fields: [businessPartnerId], references: [id])
  salesOrder      SalesOrder         @relation(fields: [salesOrderId], references: [id])
  lines           DeliveryNoteLine[]

  @@unique([organizationId, dnNumber])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryNoteId    String  @map("delivery_note_id") @db.Uuid
  salesOrderLineId  String  @map("sales_order_line_id") @db.Uuid
  itemId            String  @map("item_id") @db.Uuid
  quantityDelivered Decimal @map("quantity_delivered") @db.Decimal(14, 4)
  // Carried in at the SO line's own selling rate — a Delivery Note doesn't
  // set a new price, it just confirms quantity physically shipped. Purely
  // descriptive/audit; the eventual Sales Invoice sets its own rate
  // independently (same convention as GoodsReceiptNoteLine.unitCost vs a
  // Purchase Bill's own rate).
  rate              Decimal @db.Decimal(14, 2)
  // The actual blended cost consumeStock returned when this note posted
  // (FIFO/weighted-avg as of that moment) — captured here so the eventual
  // Sales Invoice's COGS debit reuses this exact figure instead of calling
  // consumeStock a second time, which would double-consume stock.
  unitCost          Decimal @map("unit_cost") @db.Decimal(14, 4)
  // Running total of quantity already invoiced against this specific
  // Delivery Note line — see routes/salesInvoices.ts. Never exceeds
  // quantityDelivered (enforced server-side at invoice-post time) — this
  // is the 3-way match.
  billedQuantity    Decimal @default(0) @map("billed_quantity") @db.Decimal(14, 4)

  deliveryNote      DeliveryNote       @relation(fields: [deliveryNoteId], references: [id])
  salesOrderLine    SalesOrderLine     @relation(fields: [salesOrderLineId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  salesInvoiceLines SalesInvoiceLine[]

  @@map("delivery_note_lines")
}

// ── Sales Return (Credit Note) ──────────────────────────────────────────
// Always tied to the original Sales Invoice — never freeform — so a line
// can never return more than (invoiced qty - already returned qty). Each
// line carries a condition: GOOD stock re-enters sellable on-hand (new
// FIFO lot at the original invoice line's cost, or folded into the
// weighted average); DAMAGED reverses the sale the same way but the cost
// posts to Inventory Adjustments instead of back to stock, and no
// StockMovement is created — it never touches sellable on-hand, so it
// won't appear in the Stock Ledger either. The return document itself is
// the audit trail for that.
model SalesReturn {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  branchId          String?  @map("branch_id") @db.Uuid
  salesInvoiceId    String   @map("sales_invoice_id") @db.Uuid
  businessPartnerId String   @map("business_partner_id") @db.Uuid
  returnNumber      String   @map("return_number") @db.VarChar(30)
  returnDate        DateTime @map("return_date") @db.Date
  narration         String   @default("") @db.VarChar(255)
  journalEntryId    String   @unique @map("journal_entry_id") @db.Uuid
  subtotal          Decimal  @db.Decimal(14, 2)
  taxTotal          Decimal  @map("tax_total") @db.Decimal(14, 2)
  grandTotal        Decimal  @map("grand_total") @db.Decimal(14, 2)
  totalCogsReversed Decimal  @map("total_cogs_reversed") @db.Decimal(14, 2)
  // Customer identity at posting time — GSTR-1's credit note table reads
  // these rather than the master. See SalesInvoice above and migration_031.
  partyGstin        String?  @map("party_gstin") @db.VarChar(15)
  partyName         String?  @map("party_name") @db.VarChar(200)
  partyStateCode    String?  @map("party_state_code") @db.VarChar(2)
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization      @relation(fields: [organizationId], references: [id])
  branch          Branch?           @relation(fields: [branchId], references: [id])
  salesInvoice    SalesInvoice      @relation(fields: [salesInvoiceId], references: [id])
  businessPartner BusinessPartner   @relation(fields: [businessPartnerId], references: [id])
  journalEntry    JournalEntry      @relation(fields: [journalEntryId], references: [id])
  lines           SalesReturnLine[]

  @@unique([organizationId, returnNumber])
  @@map("sales_returns")
}

model SalesReturnLine {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesReturnId      String  @map("sales_return_id") @db.Uuid
  salesInvoiceLineId String  @map("sales_invoice_line_id") @db.Uuid
  itemId             String  @map("item_id") @db.Uuid
  quantity           Decimal @db.Decimal(14, 4)
  condition          String  @db.VarChar(10) // GOOD | DAMAGED
  rate               Decimal @db.Decimal(14, 2) // snapshot of the original invoice line's rate
  taxRate            Decimal @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal       Decimal @map("line_subtotal") @db.Decimal(14, 2)
  taxAmount          Decimal @map("tax_amount") @db.Decimal(14, 2)
  lineTotal          Decimal @map("line_total") @db.Decimal(14, 2)
  unitCost           Decimal @map("unit_cost") @db.Decimal(14, 4) // snapshot of the original invoice line's cost
  lineCogsReversed   Decimal @map("line_cogs_reversed") @db.Decimal(14, 2)
  // The CGST/SGST vs IGST split, decided once at posting from the branch
  // and customer state codes. Before migration_031 this was recomputed on
  // every GST report read, so editing a partner's state flipped the split
  // on returns that had already been filed the other way.
  cgstAmount         Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount         Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount         Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)

  salesReturn      SalesReturn      @relation(fields: [salesReturnId], references: [id])
  salesInvoiceLine SalesInvoiceLine @relation(fields: [salesInvoiceLineId], references: [id])
  item             Item             @relation(fields: [itemId], references: [id])

  @@map("sales_return_lines")
}

// ── Purchase Return (Debit Note) ────────────────────────────────────────
// Always tied to the original Purchase Bill, same capped-quantity rule as
// Sales Return. No condition split — the stock is leaving to the vendor
// regardless of its state, so GOOD/DAMAGED doesn't apply here.
model PurchaseReturn {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  branchId          String?  @map("branch_id") @db.Uuid
  purchaseBillId    String   @map("purchase_bill_id") @db.Uuid
  businessPartnerId String   @map("business_partner_id") @db.Uuid
  returnNumber      String   @map("return_number") @db.VarChar(30)
  returnDate        DateTime @map("return_date") @db.Date
  narration         String   @default("") @db.VarChar(255)
  journalEntryId    String   @unique @map("journal_entry_id") @db.Uuid
  subtotal          Decimal  @db.Decimal(14, 2)
  taxTotal          Decimal  @map("tax_total") @db.Decimal(14, 2)
  grandTotal        Decimal  @map("grand_total") @db.Decimal(14, 2)
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization         @relation(fields: [organizationId], references: [id])
  branch          Branch?              @relation(fields: [branchId], references: [id])
  purchaseBill    PurchaseBill         @relation(fields: [purchaseBillId], references: [id])
  businessPartner BusinessPartner      @relation(fields: [businessPartnerId], references: [id])
  journalEntry    JournalEntry         @relation(fields: [journalEntryId], references: [id])
  lines           PurchaseReturnLine[]

  @@unique([organizationId, returnNumber])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseReturnId   String  @map("purchase_return_id") @db.Uuid
  purchaseBillLineId String  @map("purchase_bill_line_id") @db.Uuid
  itemId             String  @map("item_id") @db.Uuid
  quantity           Decimal @db.Decimal(14, 4)
  rate               Decimal @db.Decimal(14, 2)
  taxRate            Decimal @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal       Decimal @map("line_subtotal") @db.Decimal(14, 2)
  taxAmount          Decimal @map("tax_amount") @db.Decimal(14, 2)
  lineTotal          Decimal @map("line_total") @db.Decimal(14, 2)
  // Split pinned at posting — see SalesReturnLine and migration_031. This
  // one feeds GSTR-3B's ITC reversal.
  cgstAmount         Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount         Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount         Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)

  purchaseReturn   PurchaseReturn   @relation(fields: [purchaseReturnId], references: [id])
  purchaseBillLine PurchaseBillLine @relation(fields: [purchaseBillLineId], references: [id])
  item             Item             @relation(fields: [itemId], references: [id])

  @@map("purchase_return_lines")
}

// Both directions (found stock / write-off) in one document — a single
// signed line list, same reasoning as SmartAppt keeping one screen for a
// two-way toggle rather than splitting it into two document types. Also
// how opening stock gets entered: an IN line dated at go-live is
// indistinguishable from any other correction.
model StockAdjustment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  adjustmentDate DateTime @map("adjustment_date") @db.Date
  narration      String   @default("") @db.VarChar(255)
  journalEntryId String   @unique @map("journal_entry_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id])
  branch       Branch?               @relation(fields: [branchId], references: [id])
  journalEntry JournalEntry          @relation(fields: [journalEntryId], references: [id])
  lines        StockAdjustmentLine[]

  @@map("stock_adjustments")
}

model StockAdjustmentLine {
