  "login": "A",
  "asserts": [
   "sql \"SELECT sum(debit)-sum(credit) FROM journal_lines l JOIN journal_entries e ON e.id=l.journal_entry_id WHERE e.reference_type='depreciation_run'\" = 0"
  ],
