  "asserts": [
   "sql \"SELECT coalesce(sum(l.debit-l.credit),0) FROM journal_lines l JOIN journal_entries e ON e.id=l.journal_entry_id JOIN accounts a ON a.id=l.account_id WHERE e.organization_id={{ORG_A}} AND e.entry_date<='2026-07-31' AND a.account_code='4020'\" = {{regTotal}}"
  ],
  "auto": "YES"
 },
