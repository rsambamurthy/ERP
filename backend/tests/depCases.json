   "sql \"SELECT count(DISTINCT l.business_partner_id) FROM journal_lines l JOIN journal_entries e ON e.id=l.journal_entry_id WHERE e.reference_type='depreciation_run' AND e.entry_date='2026-04-30' AND e.organization_id={{ORG_A}} AND l.credit>0\" >= 3"
  ],
