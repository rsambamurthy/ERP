  "asserts": [
   "sql \"SELECT coalesce(sum(l.credit-l.debit),0) FROM journal_lines l JOIN journal_entries e ON e.id=l.journal_entry_id JOIN accounts a ON a.id=l.account_id WHERE e.organization_id={{ORG_A}} AND e.entry_date<='2026-07-31' AND a.account_code IN ('1451','1452','1454','1455')\" = {{regTotal}}"
  ],
  "auto": "YES"
 },
 {
  "key": "DEP-19.3",
  "caseId": "DEP-19",
  "caseTitle": "The register reconciles to the ledger",
