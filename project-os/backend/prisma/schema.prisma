// Project OS — R1 Pilot schema.
// Entities match PRD Section 8 (prd-r1-pilot.docx). Separate database
// from SmartERP — SmartERP master data is mirrored here read-only via
// the Synced* models (Section 9.1); nothing here is a foreign key into
// SmartERP's actual database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Organisation & Users (Section 6.1)
// ---------------------------------------------------------------------

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  orgUsers          OrgUser[]
  costCategories    CostCategory[]
  projects          Project[]
  purchaseOrders    PurchaseOrder[]
  stockLocations    StockLocation[]
  syncedBusinessPartners SyncedBusinessPartner[]
  syncedItems       SyncedItem[]
  syncedBranches    SyncedBranch[]
  smartErpConnection SmartErpConnection?

  @@map("organizations")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?   @db.VarChar(150)
  email        String?   @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(20)
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  orgUsers OrgUser[]

  @@map("users")
}

// Roles per PRD Section 10. One row per (org, user) — a user can belong
// to more than one pilot org in principle, though R1 only ever expects
// one (Section 13 Assumptions: one Project OS tenant per SmartERP tenant).
model OrgUser {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @db.VarChar(30) // SUPER_ADMIN | PROJECT_MANAGER | ESTIMATOR | PROCUREMENT | WAREHOUSE | SITE_ENGINEER
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  projectTeamMemberships ProjectTeamMember[]

  @@unique([organizationId, userId])
  @@map("org_users")
}

// ---------------------------------------------------------------------
// SmartERP integration (Section 9) — connection config + synced masters.
// Read-only mirrors; editing still happens in SmartERP (Section 9.1).
// ---------------------------------------------------------------------

model SmartErpConnection {
  organizationId String    @id @map("organization_id") @db.Uuid
  apiBaseUrl     String    @map("api_base_url")
  // Placeholder for however the API key/secret ends up stored — plain
  // column for now since encryption-at-rest strategy isn't decided;
  // flagged here rather than silently assumed.
  apiKeyCiphertext String? @map("api_key_ciphertext")
  lastSyncedAt   DateTime? @map("last_synced_at")
  lastSyncStatus String?   @map("last_sync_status") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("smarterp_connections")
}

// bpType mirrors SmartERP's own BusinessPartner.bpType convention
// (CUSTOMER | VENDOR) — same table serves both, filtered by type,
// exactly as SmartERP's own businessPartners table does.
model SyncedBusinessPartner {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  externalId     String   @map("external_id") @db.Uuid // SmartERP business_partners.id
  bpType         String   @map("bp_type") @db.VarChar(20)
  name           String   @db.VarChar(200)
  gstin          String?  @db.VarChar(15)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(255)
  address        Json?
  stateCode      String?  @map("state_code") @db.VarChar(2)
  syncedAt       DateTime @default(now()) @map("synced_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  projectsAsCustomer Project[]
  rfqSuppliers RfqSupplier[]
  supplierQuotations SupplierQuotation[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, externalId])
  @@map("synced_business_partners")
}

model SyncedItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  externalId     String   @map("external_id") @db.Uuid // SmartERP items.id
  sku            String   @db.VarChar(50)
  name           String   @db.VarChar(200)
  uom            String   @db.VarChar(20)
  hsnCode        String?  @map("hsn_code") @db.VarChar(10)
  purchaseRate   Decimal? @map("purchase_rate") @db.Decimal(14, 2)
  salesRate      Decimal? @map("sales_rate") @db.Decimal(14, 2)
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  syncedAt       DateTime @default(now()) @map("synced_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  boqLines BoqLine[]
  purchaseOrderLines PurchaseOrderLine[]
  stockLedgerEntries StockLedgerEntry[]
  materialConsumptions MaterialConsumption[]

  @@unique([organizationId, externalId])
  @@map("synced_items")
}

model SyncedBranch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  externalId     String   @map("external_id") @db.Uuid // SmartERP branches.id
  code           String   @db.VarChar(20)
  name           String   @db.VarChar(200)
  gstin          String?  @db.VarChar(15)
  stateCode      String?  @map("state_code") @db.VarChar(2)
  syncedAt       DateTime @default(now()) @map("synced_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, externalId])
  @@map("synced_branches")
}

// ---------------------------------------------------------------------
// Cost category master (Section 6.1) — native, no SmartERP equivalent.
// ---------------------------------------------------------------------

model CostCategory {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(20) // MATERIAL | LABOUR | SUBCONTRACT | OVERHEAD | OTHER
  isSystem       Boolean @default(true) @map("is_system")

  organization Organization @relation(fields: [organizationId], references: [id])
  boqLines BoqLine[]
  budgets Budget[]

  @@unique([organizationId, name])
  @@map("cost_categories")
}

// ---------------------------------------------------------------------
// Project & Contract (Section 6.2)
// ---------------------------------------------------------------------

model Project {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  code                String    @db.VarChar(30)
  name                String    @db.VarChar(200)
  customerId          String?   @map("customer_id") @db.Uuid // SyncedBusinessPartner, bpType=CUSTOMER
  // Draft -> Awarded -> Active -> On Hold -> Substantially Complete -> Closed
  status              String    @default("DRAFT") @db.VarChar(30)
  startDate           DateTime? @map("start_date") @db.Date
  targetEndDate       DateTime? @map("target_end_date") @db.Date
  // Project-level PO approval threshold (Section 6.2) — null means every
  // PO on this project requires manual approval, same "null = safest
  // default" convention SmartERP's own poApprovalThreshold uses.
  poApprovalThreshold Decimal?  @map("po_approval_threshold") @db.Decimal(14, 2)
  createdAt           DateTime  @default(now()) @map("created_at")
  deletedAt            DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     SyncedBusinessPartner? @relation(fields: [customerId], references: [id])
  sites        ProjectSite[]
  team         ProjectTeamMember[]
  contract     Contract?
  boqs         Boq[]
  budgets      Budget[]
  materialRequests MaterialRequest[]
  purchaseOrders PurchaseOrder[]
  activities   Activity[]

  @@unique([organizationId, code])
  @@map("projects")
}

model ProjectSite {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  name      String  @db.VarChar(200)
  address   Json?
  // Open question (PRD Section 9.4, not resolved): whether a Project
  // Site needs its own GST state code distinct from the SmartERP Branch
  // that transacts for it. Column added now so the decision doesn't
  // also require a migration later; nullable and unused until resolved.
  stateCode String? @map("state_code") @db.VarChar(2)
  createdAt DateTime @default(now()) @map("created_at")

  project        Project         @relation(fields: [projectId], references: [id])
  stockLocations StockLocation[]

  @@map("project_sites")
}

model ProjectTeamMember {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  orgUserId String @map("org_user_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id])
  orgUser OrgUser @relation(fields: [orgUserId], references: [id])

  @@unique([projectId, orgUserId])
  @@map("project_team_members")
}

model Contract {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String   @unique @map("project_id") @db.Uuid
  value          Decimal  @db.Decimal(16, 2)
  currency       String   @default("INR") @db.VarChar(3)
  retentionPct   Decimal? @map("retention_pct") @db.Decimal(5, 2)
  advancePct     Decimal? @map("advance_pct") @db.Decimal(5, 2)
  // Captured as data in R1, not acted on — the billing logic that
  // consumes these is R2 (PRD Section 6.2).
  paymentTerms   String?  @map("payment_terms") @db.VarChar(500)
  milestoneTerms String?  @map("milestone_terms") @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("contracts")
}

// ---------------------------------------------------------------------
// BOQ & Estimation (Section 6.3)
// ---------------------------------------------------------------------

model Boq {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  version   Int      @default(1)
  // Draft -> Imported -> Validated -> Approved -> Revised -> Superseded
  status    String   @default("DRAFT") @db.VarChar(20)
  sourceFileName String? @map("source_file_name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  project Project   @relation(fields: [projectId], references: [id])
  lines   BoqLine[]

  @@unique([projectId, version])
  @@map("boqs")
}

model BoqLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boqId          String   @map("boq_id") @db.Uuid
  lineNo         Int      @map("line_no")
  description    String   @db.VarChar(500)
  itemId         String?  @map("item_id") @db.Uuid
  costCategoryId String?  @map("cost_category_id") @db.Uuid
  uom            String   @db.VarChar(20)
  quantity       Decimal  @db.Decimal(14, 4)
  rate           Decimal  @db.Decimal(14, 2)
  amount         Decimal  @db.Decimal(16, 2)
  billable       Boolean  @default(true)

  boq          Boq            @relation(fields: [boqId], references: [id])
  item         SyncedItem?    @relation(fields: [itemId], references: [id])
  costCategory CostCategory?  @relation(fields: [costCategoryId], references: [id])
  estimate     Estimate?
  materialRequests MaterialRequest[]
  activities   Activity[]

  @@unique([boqId, lineNo])
  @@map("boq_lines")
}

model Estimate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boqLineId       String   @unique @map("boq_line_id") @db.Uuid
  materialCost    Decimal  @default(0) @map("material_cost") @db.Decimal(16, 2)
  labourCost      Decimal  @default(0) @map("labour_cost") @db.Decimal(16, 2)
  subcontractCost Decimal  @default(0) @map("subcontract_cost") @db.Decimal(16, 2)
  overheadCost    Decimal  @default(0) @map("overhead_cost") @db.Decimal(16, 2)
  totalCost       Decimal  @default(0) @map("total_cost") @db.Decimal(16, 2)
  version         Int      @default(1)
  approvalStatus  String   @default("DRAFT") @map("approval_status") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")

  boqLine BoqLine @relation(fields: [boqLineId], references: [id])

  @@map("estimates")
}

model Budget {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  version         Int      @default(1)
  costCategoryId  String   @map("cost_category_id") @db.Uuid
  baselineAmount  Decimal  @map("baseline_amount") @db.Decimal(16, 2)
  approvedAmount  Decimal? @map("approved_amount") @db.Decimal(16, 2)
  status          String   @default("DRAFT") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")

  project      Project      @relation(fields: [projectId], references: [id])
  costCategory CostCategory @relation(fields: [costCategoryId], references: [id])

  @@map("budgets")
}

// ---------------------------------------------------------------------
// Procurement (Section 6.4)
// ---------------------------------------------------------------------

model MaterialRequest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  boqLineId String?  @map("boq_line_id") @db.Uuid
  quantity  Decimal  @db.Decimal(14, 4)
  // Draft -> Submitted -> Approved -> Partially Ordered -> Fulfilled -> Closed
  status    String   @default("DRAFT") @db.VarChar(30)
  requestedByOrgUserId String? @map("requested_by_org_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  project Project  @relation(fields: [projectId], references: [id])
  boqLine BoqLine? @relation(fields: [boqLineId], references: [id])
  rfqs    Rfq[]

  @@map("material_requests")
}

model Rfq {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialRequestId String   @map("material_request_id") @db.Uuid
  // Draft -> Issued -> Responses Received -> Evaluated -> Closed
  status            String   @default("DRAFT") @db.VarChar(30)
  createdAt         DateTime @default(now()) @map("created_at")

  materialRequest MaterialRequest     @relation(fields: [materialRequestId], references: [id])
  suppliers       RfqSupplier[]
  quotations      SupplierQuotation[]

  @@map("rfqs")
}

model RfqSupplier {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rfqId      String @map("rfq_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid

  rfq      Rfq                    @relation(fields: [rfqId], references: [id])
  supplier SyncedBusinessPartner  @relation(fields: [supplierId], references: [id])

  @@unique([rfqId, supplierId])
  @@map("rfq_suppliers")
}

model SupplierQuotation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rfqId         String   @map("rfq_id") @db.Uuid
  supplierId    String   @map("supplier_id") @db.Uuid
  price         Decimal  @db.Decimal(16, 2)
  freight       Decimal  @default(0) @db.Decimal(14, 2)
  tax           Decimal  @default(0) @db.Decimal(14, 2)
  deliveryDays  Int?     @map("delivery_days")
  paymentTerms  String?  @map("payment_terms") @db.VarChar(500)
  selected      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  rfq      Rfq                    @relation(fields: [rfqId], references: [id])
  supplier SyncedBusinessPartner  @relation(fields: [supplierId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@map("supplier_quotations")
}

// PO ownership decision (PRD Section 9.2): Project OS is the source of
// record. smartErpExternalId/smartErpSyncStatus track the one-way push
// of a pre-approved shadow PO into SmartERP — not a two-way sync.
model PurchaseOrder {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  quotationId   String?   @map("quotation_id") @db.Uuid
  supplierId    String    @map("supplier_id") @db.Uuid
  poNumber      String    @map("po_number") @db.VarChar(30) // project-scoped sequence
  // Draft -> Pending Approval -> Approved -> Sent -> Partially Received -> Closed/Cancelled
  status        String    @default("DRAFT") @db.VarChar(30)
  grandTotal    Decimal   @default(0) @map("grand_total") @db.Decimal(16, 2)
  approvedByOrgUserId String? @map("approved_by_org_user_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  // Section 9.2 shadow-PO push tracking — null until pushed.
  smartErpExternalId String? @map("smarterp_external_id") @db.Uuid
  smartErpSyncStatus String? @map("smarterp_sync_status") @db.VarChar(20) // PENDING | SYNCED | FAILED
  smartErpSyncError  String? @map("smarterp_sync_error") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], map: "po_org_fk")
  project      Project      @relation(fields: [projectId], references: [id])
  quotation    SupplierQuotation? @relation(fields: [quotationId], references: [id])
  supplier     SyncedBusinessPartner @relation(fields: [supplierId], references: [id])
  lines        PurchaseOrderLine[]
  receipts     Receipt[]

  @@unique([projectId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  itemId          String  @map("item_id") @db.Uuid
  quantity        Decimal @db.Decimal(14, 4)
  rate            Decimal @db.Decimal(14, 2)
  amount          Decimal @db.Decimal(16, 2)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 4)
  // Set once the parent PO's shadow push succeeds (lib/smartErpPush.ts) —
  // matched against the response's lines by item externalId, since
  // SmartERP creates its own PurchaseOrderLine rows with new ids that
  // have no other correlation back to these. Needed so a Receipt on this
  // line can itself be pushed as a shadow GRN, which requires SmartERP's
  // own purchaseOrderLineId, not this one.
  smartErpExternalId String? @map("smarterp_external_id") @db.Uuid

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  item          SyncedItem    @relation(fields: [itemId], references: [id])
  receiptLines  ReceiptLine[]

  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------
// Inventory (Section 6.5) — basic
// ---------------------------------------------------------------------

model StockLocation {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  type          String  @db.VarChar(20) // WAREHOUSE | PROJECT_SITE
  name          String  @db.VarChar(200)
  projectSiteId String? @map("project_site_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  projectSite ProjectSite? @relation(fields: [projectSiteId], references: [id])
  receipts    Receipt[]
  stockLedgerEntries StockLedgerEntry[]

  @@map("stock_locations")
}

model Receipt {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String    @map("purchase_order_id") @db.Uuid
  locationId      String    @map("location_id") @db.Uuid
  receivedAt      DateTime  @default(now()) @map("received_at")
  smartErpExternalId String? @map("smarterp_external_id") @db.Uuid
  smartErpSyncStatus String? @map("smarterp_sync_status") @db.VarChar(20)
  smartErpSyncError  String? @map("smarterp_sync_error") @db.VarChar(500)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  location      StockLocation @relation(fields: [locationId], references: [id])
  lines         ReceiptLine[]

  @@map("receipts")
}

model ReceiptLine {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId           String  @map("receipt_id") @db.Uuid
  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  quantity            Decimal @db.Decimal(14, 4)

  receipt           Receipt           @relation(fields: [receiptId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  @@map("receipt_lines")
}

model StockLedgerEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  transactionType String   @map("transaction_type") @db.VarChar(20) // RECEIPT | TRANSFER_IN | TRANSFER_OUT | ISSUE | RETURN
  quantity        Decimal  @db.Decimal(14, 4)
  referenceType   String?  @map("reference_type") @db.VarChar(30)
  referenceId     String?  @map("reference_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  item     SyncedItem    @relation(fields: [itemId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@map("stock_ledger_entries")
}

// ---------------------------------------------------------------------
// Site Execution (Section 6.6) — basic
// ---------------------------------------------------------------------

model Activity {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  boqLineId String? @map("boq_line_id") @db.Uuid
  name      String  @db.VarChar(200)
  status    String  @default("OPEN") @db.VarChar(20)

  project Project  @relation(fields: [projectId], references: [id])
  boqLine BoqLine? @relation(fields: [boqLineId], references: [id])
  progressRecords ProgressRecord[]
  materialConsumptions MaterialConsumption[]

  @@map("activities")
}

model ProgressRecord {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId   String   @map("activity_id") @db.Uuid
  quantity     Decimal  @db.Decimal(14, 4)
  recordedByOrgUserId String? @map("recorded_by_org_user_id") @db.Uuid
  recordedAt   DateTime @default(now()) @map("recorded_at")

  activity Activity @relation(fields: [activityId], references: [id])

  @@map("progress_records")
}

model MaterialConsumption {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  quantity   Decimal  @db.Decimal(14, 4)
  recordedAt DateTime @default(now()) @map("recorded_at")

  activity Activity   @relation(fields: [activityId], references: [id])
  item     SyncedItem @relation(fields: [itemId], references: [id])

  @@map("material_consumptions")
}
